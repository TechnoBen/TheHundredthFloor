                <<set $blockingModifier to 1>>
                <<set $evadeModifier to 0>>
                <<HitRelatedStatusMobs>>
            <</if>>
        /* Poisonous tongue */
        <<elseif _mobSkill <= 6>>
            <<if _randomHit <= $partyMembers.length - 1>>
                <<set _npc = $NPCs[$partyMembers[_randomHit]]>>
                <<if _npc.evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].PierceSTR - (_npc.PierceDEF + _npc.armorPierceDEF)) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' pierces ' + _npc.name + ' with its tongue and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, poisoning them.')>>
                        <<GettingHit>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].PierceSTR - (_npc.PierceDEF + _npc.armorPierceDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' pierces ' + _npc.name + ' with its tongue and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, poisoning them.')>>
                        <<GettingCritted>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<else>>
                    <<run $combat_log.push(_npc.name + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set _npc.blockingModifier to 1>>
                <<set _npc.evadeModifier to 0>>
                <<HitRelatedStatusMobs>>
            <<else>>
                <<if $evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].PierceSTR - ($PierceDEF + $armorPierceDEF)) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' pierces ' + $gamename + ' with its tongue and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, poisoning them.')>>
                        <<set $poisoned1 to 12>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].PierceSTR - ($PierceDEF + $armorPierceDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' pierces ' + $gamename + ' with its tongue and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, poisoning them.')>>
                        <<set $poisoned1 to 15>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<else>>
                    <<run $combat_log.push($gamename + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set $blockingModifier to 1>>
                <<set $evadeModifier to 0>>
                <<HitRelatedStatusMobs>>
            <</if>>
        <</if>>
    <</if>>
    /* Boldegar */
    <<if _mob[_i].name is "Boldegar" && _mob[_i].turnChanceCur >= 0.01>>
        <<set _mobSkill to random(0, 100)>>
        <<set _randomHit to random(0, $partyMembers.length)>>
        <<set _critChanceRNG to kitsuneRNG(0, 100)>>
        <<set _mobHit to kitsuneRNG(0, 100)>>
        /* Molten rock */
        <<if _mobSkill >= 90>>
            <<if _randomHit <= $partyMembers.length - 1>>
                <<set _npc = $NPCs[$partyMembers[_randomHit]]>>
                <<if _npc.evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].PierceSTR - (_npc.PierceDEF + _npc.armorPierceDEF)) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' throws a molten rock at ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, setting them on fire.')>>
						<<set _npc.burnPotency += _mob[_i].burnPotencyDealt>>
						<<set _npc.burnCountCur += _mob[_i].burnCountDealt>>
                        <<GettingHit>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].PierceSTR - (_npc.PierceDEF + _npc.armorPierceDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' throws a molten rock at ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, setting them on fire.')>>
						<<set _npc.burnPotency += _mob[_i].burnPotencyDealt*2>>
						<<set _npc.burnCountCur += _mob[_i].burnCountDealt*2>>
                        <<GettingCritted>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<else>>
                    <<run $combat_log.push(_npc.name + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set _npc.blockingModifier to 1>>
                <<set _npc.evadeModifier to 0>>
                <<HitRelatedStatusMobs>>
            <<else>>
                <<if $evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].PierceSTR - ($PierceDEF + $armorPierceDEF)) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' throws a molten rock at ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, setting them on fire.')>>
                        <<set $burnPotency += _mob[_i].burnPotencyDealt>>
						<<set $burnCountCur += _mob[_i].burnCountDealt>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].PierceSTR - ($PierceDEF + $armorPierceDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' throws a molten rock at ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage, setting them on fire.')>>
                        <<CritRelatedStatusesMobs>>
                        <<set $burnPotency += _mob[_i].burnPotencyDealt*2>>
						<<set $burnCountCur += _mob[_i].burnCountDealt*2>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push($gamename + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set $blockingModifier to 1>>
                <<set $evadeModifier to 0>>
            <</if>>
        /* Slam */
        <<if _mobSkill >= 7>>
            <<if _randomHit <= $partyMembers.length - 1>>
                <<set _npc = $NPCs[$partyMembers[_randomHit]]>>
                <<if _npc.evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].BluntSTR - (_npc.BluntDEF + _npc.armorBluntDEF)) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slams ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                        <<GettingHit>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].BluntSTR - (_npc.BluntDEF + _npc.armorBluntDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slams ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                        <<GettingCritted>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push(_npc.name + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set _npc.blockingModifier to 1>>
                <<set _npc.evadeModifier to 0>>
            <<else>>
                <<if $evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].BluntSTR - ($BluntDEF + $armorBluntDEF)) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slams ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].BluntSTR - ($BluntDEF + $armorBluntDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slams ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push($gamename + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set $blockingModifier to 1>>
                <<set $evadeModifier to 0>>
            <</if>>
        <</if>>
    <</if>>
<</if>>
/* Player killers */
    <<if _mob[_i].name is "Player killer" && _mob[_i].turnChanceCur >= 0.01>>
        <<set _mobSkill to random(0, 100)>>
        <<set _randomHit to random(0, $partyMembers.length)>>
        <<set _critChanceRNG to kitsuneRNG(0, 100)>>
        <<set _mobHit to kitsuneRNG(0, 100)>>
        /* Slashing */
        <<if _mobSkill >= 13>>
            <<if _randomHit <= $partyMembers.length - 1>>
                <<set _npc = $NPCs[$partyMembers[_randomHit]]>>
                <<if _npc.evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].SlashSTR - (_npc.SlashDEF + _npc.armorSlashDEF)) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
						<<set _npc.bleedCountCur += _mob[_i].bleedCountDealt>>
						<<set _npc.bleedPotency += _mob[_i].bleedPotencyDealt * _npc.bleedDef>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slashes at ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                        <<GettingHit>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].SlashSTR - (_npc.SlashDEF + _npc.armorSlashDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
						<<set _npc.bleedCountCur += _mob[_i].bleedCountDealt>>
						<<set _npc.bleedPotency += (_mob[_i].bleedPotencyDealt*1.5) * _npc.bleedDef>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slashes at ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                        <<GettingCritted>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push(_npc.name + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set _npc.blockingModifier to 1>>
                <<set _npc.evadeModifier to 0>>
            <<else>>
                <<if $evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to ((_mob[_i].SlashSTR - ($SlashDEF + $armorSlashDEF)) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
						<<set $bleedCountCur += _mob[_i].bleedCountDealt>>
						<<set $bleedPotency += _mob[_i].bleedPotencyDealt * $bleedDef>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slashes at ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                    <<else>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].SlashSTR - ($SlashDEF + $armorSlashDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
						<<set $bleedCountCur += _mob[_i].bleedCountDealt>>
						<<set $bleedPotency += (_mob[_i].bleedPotencyDealt*1.5) * $bleedDef>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' slashes at ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push($gamename + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set $blockingModifier to 1>>
                <<set $evadeModifier to 0>>
            <</if>>
        /* Paralize */
        <<elseif _mobSkill <= 20>>
            <<if _randomHit <= $partyMembers.length - 1>>
                <<set _npc = $NPCs[$partyMembers[_randomHit]]>>
                <<if _npc.evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].PierceSTR + _mob[_i].DEX / 2) - (_npc.PierceDEF + _npc.armorPierceDEF)) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' stabs ' + _npc.name + ' with a paralizing knife and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                        <<GettingHit>>
                    <<else>>
                        <<set _mob[_i].baseDMG to ((((_mob[_i].PierceSTR + _mob[_i].DEX / 2) - (_npc.PierceDEF + _npc.armorPierceDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                        <<set _npc.CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' stabs ' + _npc.name + ' with a paralizing knife and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                        <<GettingCritted>>
                        <<CritRelatedStatusesMobs>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push(_npc.name + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set _npc.blockingModifier to 1>>
                <<set _npc.evadeModifier to 0>>
            <<else>>
                <<if $evadeModifier <= _mobHit>>
                    <<if _mob[_i].CritChance <= _critChanceRNG>>
                        <<set _mob[_i].baseDMG to (((_mob[_i].PierceSTR + _mob[_i].DEX / 2) - ($PierceDEF + $armorPierceDEF)) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' stabs ' + $gamename + ' with a paralizing knife and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                        <<if $paralized <= 0>>
                            <<set $paralized to 8>>
                        <</if>>
                    <<else>>
                        <<set _mob[_i].baseDMG to ((((_mob[_i].PierceSTR + _mob[_i].DEX / 2) - ($PierceDEF + $armorPierceDEF)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                        <<set $CurHP -= _mob[_i].baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' and stabs ' + $gamename + ' with a paralizing knife and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                        <<CritRelatedStatusesMobs>>
                        <<if $paralized <= 0>>
                            <<set $paralized to 8>>
                        <</if>>
                    <</if>>
                <<HitRelatedStatusMobs>>
                <<else>>
                    <<run $combat_log.push($gamename + ' dodges the attack from ' + _mob[_i].name)>>
                <</if>>
                <<set $blockingModifier to 1>>
                <<set $evadeModifier to 0>>
            <</if>>
        <</if>>
    <</if>>
    /* Other mobs? */
<</for>>

<<bleedTrigger>>
<<burnEnemy>>
<<PowerUpCountMobs>>

<<if $CDThroatSlit>>
    <<set $CDThroatSlit -= 1>>
    <<if $CDThroatSlit == 0>>
        <<unset $CDThroatSlit>>
    <</if>>
<</if>>

<<if $CDLeapingSlash>>
    <<set $CDLeapingSlash -= 1>>
    <<if $CDLeapingSlash == 0>>
        <<unset $CDLeapingSlash>>
    <</if>>
<</if>>

<<if $CDMultistrike>>
    <<set $CDMultistrike -= 1>>
    <<if $CDMultistrike == 0>>
        <<unset $CDMultistrike>>
    <</if>>
<</if>>

<<if $CDMultistrikeRadiant>>
    <<set $CDMultistrikeRadiant -= 1>>
    <<if $CDMultistrikeRadiant == 0>>
        <<unset $CDMultistrikeRadiant>>
    <</if>>
<</if>>

/* Mobs dying */
<<for _i = 0; _i lt $mobs.length; _i++>>
  <<if _mob[_i].CurHP <= 0.01>>
    <<MobRewards>>
    <<run $combat_log.push('Level ' + $mobs[_i].lvl + ' ' + $mobs[_i].name + ' has been slain.')>>
  	<<run $mobs.deleteAt(_i)>>
  <</if>>
<</for>>

/* FEED THE WOLFIE!!!!! */
<<if $attack == "Feed dog">>
<<set $attackText to "Feed dog">>
	<<set $wolfTame += 1>>
    <<set $ragoutMeat -= 1>>
<</if>>

/* WOLF TAMED */
<<if $wolfTame >= 3 && $monstername === "Black wolf">>
	<<goto "Wolf tame 1">>
<</if>>

<<dateadd '1m'>>

/* DMG DEALT MSG + LIFE STEAL RING FIX */
<<set $dmgDealt.Combat to 0>>

/* Turns getting fixed for player turn */
<<set $turnChanceCur to $turnChanceMax>>
<<set $NPCs.RadiantRose.turnChanceCur to $NPCs.RadiantRose.turnChanceMax>>
<<set $NPCs.ShadowScythe.turnChanceCur to $NPCs.ShadowScythe.turnChanceMax>>
<<set $NPCs.CrimsonSentinel.turnChanceCur to $NPCs.CrimsonSentinel.turnChanceMax>>
<<set $NPCs.Zegrath.turnChanceCur to $NPCs.Zegrath.turnChanceMax>>
<<unset $bonusTurnPlayer>>
<<unset $bonusTurnRadiantRose>>
<<unset $bonusTurnShadowScythe>>
<<unset $bonusTurnCrimsonSentinel>>
<<unset $bonusTurnZegrath>>

/* Bonus turn mob */
<<for _i = 0; _i lt $mobs.length; _i++>>
<<set _mob[_i].turnChanceCur -= 100>>
<<set _bonusTurnRNG to random(100)>>
<<if _mob[_i].turnChanceCur > _bonusTurnRNG>>
  <<set _bonusTurn to true>>
  <<set _mob[_i].bonusTurn to 1>>
<</if>>
<</for>>

<<if _bonusTurn === true>>
	/* Bonus turn activate for mob this time */
    <<goto "Enemy turn">>
<<elseif not $mobs.length && $floorBossBattle !== true>>
	/* Combat end here */
	<<goto "Combat win">>
<</if>>

<<if settings.turns === true>>
    <<set $turns += 1>>
	<<run $combat_log.push('<span class="turnCount">--| TURN ' + $turns + ' |--</span>')>>
<</if>>

<</link>>


