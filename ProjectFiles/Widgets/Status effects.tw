<<widget HitRelatedStatusMobs>>

	/* In short, whenever a skill is meant to trigger during a hit (or crit) it activates. */

	<<if _mob[_i].PowerUpPotency >= 0.01>>
		<<set $mobs[_i].STRPercentBuff -= $mobs[_i].PowerUpPotency>>
		<<set $mobs[_i].PowerUpPotency /= 2>>
		<<set $mobs[_i].STRPercentBuff += $mobs[_i].PowerUpPotency>>
	<</if>>

<</widget>>

