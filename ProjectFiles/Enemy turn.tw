Select $NPCs.BlackWolf.name's move: <label><<radiobutton "$attackWolf" "Do nothing" checked>> Do nothing</label> | <label><<radiobutton "$attackWolf" "Block">> Block </label> | <label><<radiobutton "$attackWolf" "Dodge">> Dodge</label>
<</if>>\

<<link [[Next|Combat remake]]>>
/* Player moves */
/* Doing nothing */
<<if $attack == "Do nothing">>
    <<run $combat_log.push('You do nothing.')>>
<</if>>
/* Blocking */
<<if $attack === "Block">>
    <<set $attackText to "Block">>
    <<if $curStamina >= 6>>
        <<set $curStamina -= 6>>
        <<set $blockingModifier to 0.5>>
        <<run $combat_log.push('You get yourself in a blocking stance.')>>
    <<else>>
        <<run $combat_log.push('You are too tired to block.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attack === "Dodge">>
    <<set $attackText to "Dodge">>
    <<if $curStamina >= 10>>
        <<set $curStamina -= 10>>
        <<set $evadeModifier to 75>>
        <<run $combat_log.push('You get yourself ready to dodge')>>
    <<else>>
        <<run $combat_log.push('You are too tired to dodge.')>>
    <</if>>
<</if>>
/* HP pot tier 1 */
<<if $attack is "Drink a HP potion">>
    <<if $enemyHitPlayer === "Player">>
        <<set $attackText to "Drink HP potion">>
        <<if $hpPOT >= 1 && $potCooldown <= 0>>  
            <<set $CurHP += 50>>
            <<set $hpPOT -= 1>>
            <<set $potCooldown += 2>>
            <<run $combat_log.push('You drink a tier 1 health potion')>>
        <<elseif $hpPOT <= 0>> 
            <<set $attack to "Do nothing">>
            <<run $combat_log.push('You dont have any tier 1 health potions')>>
        <</if>>
    <<else>>
        <<for _i range $partyMembers.length>>
        <<if $enemyHitPlayer === _i>>
            <<if $hpPOT >= 1>>
                <<set _npc.CurHP += 50>>
                <<set $hpPOT -= 1>>
                <<run $combat_log.push('You give a tier 1 health potion to ' + _npc.name)>>
            <<elseif $hpPOT <= 0>>
                <<set $attack to "Do nothing">>
                <<run $combat_log.push('You dont have any tier 1 health potions to give to your teammates.')>>
            <</if>>
        <</if>>
        <</for>>
    <</if>>
<</if>>
/* HP pot tier 2 */
<<if $attack is "Drink a HP potion tier 2">>
    <<if $enemyHitPlayer === "Player">>
        <<set $attackText to "Drink HP potion">>
        <<if $hpPOT1 >= 1 && $potCooldown <= 0>>  
            <<set $RegenHP += 2>>
            <<set $RegenAmount to 60>>
            <<set $hpPOT1 -= 1>>
            <<set $potCooldown += 4>>
            <<run $combat_log.push('You drink a tier 2 potion.')>>
        <<elseif $hpPOT1 <= 0>> 
            <<set $attack to "Do nothing">>
            <<run $combat_log.push('You dont have any tier 2 health potions.')>>
        <</if>>
    <<else>>
        <<for _i range $partyMembers.length>>
        <<if $enemyHitPlayer === _i>>
            <<if $hpPOT1 >= 1>>
                <<set _npc.CurHP += 120>>
                <<set $hpPOT1 -= 1>>
                <<run $combat_log.push('You give a tier 2 health potion to ' + _name.npc)>>
            <<elseif $hpPOT1 <= 0>>
                <<set $attack to "Do nothing">>
                <<run $combat_log.push('You dont have any tier 2 health potions to give to your teammates.')>>
            <</if>>
        <</if>>
        <</for>>
    <</if>>
<</if>>
/* STM pot tier 1 */
<<if $attack is "Drink a STM potion">>
    <<if $enemyHitPlayer === "Player">>
        <<set $attackText to "Drink STM potion">>
        <<if $stmPOT >= 1 && $potCooldown <= 0>>  
            <<set $curStamina += 50>>
            <<set $curFatigue -= 100>>
            <<set $potCooldown += 2>>
            <<set $stmPOT -= 1>>
            <<run $combat_log.push('You drink a stamina potion.')>>
        <<elseif $stmPOT <= 0>> 
        <<run $combat_log.push('You dont have any stamina potions.')>>
            <<set $attack to "Do nothing">>
        <</if>>
    <<else>>
        <<for _i range $partyMembers.length>>
        <<if $enemyHitPlayer === _i>>
            <<if $stmPOT >= 1>>
                <<set _npc.CurSTM += 50>>
                <<set $stmPOT -= 1>>
                <<run $combat_log.push('You gave a stamina potion to ' + _npc.name)>>
            <<elseif $stmPOT <= 0>>
                <<run $combat_log.push('You dont have any stamina potions to give to your teammates.')>>
                <<set $attack to "Do nothing">>
            <</if>>
        <</if>>
        <</for>>
    <</if>>
<</if>>

/* Party moves */

/* RadiantRose */
<<if $partyMembers.includes("RadiantRose")>>
/* Doing nothing */

<<if $attackRadiantRose === "Do nothing">>
    <<run $combat_log.push('RadiantRose does nothing.')>>
<</if>>
/* Blocking */
<<if $attackRadiantRose === "Block">>
    <<if $NPCs.RadiantRose.CurSTM >= 8>>
        <<run $combat_log.push('RadiantRose gets into a blocking stance.')>>
        <<set $NPCs.RadiantRose.CurSTM -= 8>>
        <<set $NPCs.RadiantRose.blockingModifier to 0.5>>
    <<else>>
        <<run $combat_log.push('RadiantRose is too tired to block.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attackRadiantRose === "Dodge">>
    <<if $NPCs.RadiantRose.CurSTM >= 15>>
        <<run $combat_log.push('RadiantRose gets ready to dodge')>>
        <<set $NPCs.RadiantRose.CurSTM -= 15>>
        <<set $NPCs.RadiantRose.evadeModifier to 75>>
    <<else>>
        <<run $combat_log.push('RadiantRose is too tired to dodge.')>>
    <</if>>
<</if>>
<</if>>

