Select $NPCs.BlackWolf.name's move: <label><<radiobutton "$attackWolf" "Do nothing" checked>> Do nothing</label> | <label><<radiobutton "$attackWolf" "Block">> Block </label> | <label><<radiobutton "$attackWolf" "Dodge">> Dodge</label>
<</if>>\

<<link [[Next|Combat remake]]>>
/* Player moves */
/* Doing nothing */
<<if $attack == "Do nothing">>
    <<run $combat_log.push('You do nothing.')>>
<</if>>
/* Blocking */
<<if $attack === "Block">>
    <<set $attackText to "Block">>
    <<if $curStamina >= 6>>
        <<set $curStamina -= 6>>
        <<set $blockingModifier to 0.5>>
        <<run $combat_log.push('You get yourself in a blocking stance.')>>
    <<else>>
        <<run $combat_log.push('You are too tired to block.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attack === "Dodge">>
    <<set $attackText to "Dodge">>
    <<if $curStamina >= 10>>
        <<set $curStamina -= 10>>
        <<set $evadeModifier to 75>>
        <<run $combat_log.push('You get yourself ready to dodge')>>
    <<else>>
        <<run $combat_log.push('You are too tired to dodge.')>>
    <</if>>
<</if>>
/* HP pot tier 1 */
<<if $attack is "Drink a HP potion">>
    <<if $enemyHitPlayer === "Player" && $hpPOT >= 1 && $potCooldown <= 0>>
        <<set $CurHP += 50>>
        <<set $hpPOT -= 1>>
        <<set $potCooldown += 2>>
        <<run $combat_log.push('You drink a tier 1 health potion')>>
    <<elseif $enemyHitPlayer === "RadiantRose" && $hpPOT >= 1>>
        <<set $NPCs.RadiantRose.CurHP += 50>>
        <<set $hpPOT -= 1>>
        <<run $combat_log.push('You gave a tier 1 health potion to RadiantRose')>>
    <<elseif $enemyHitPlayer === "CrimsonSentinel" && $hpPOT >= 1>>
        <<set $NPCs.CrimsonSentinel.CurHP += 50>>
        <<set $hpPOT -= 1>>
        <<run $combat_log.push('You gave a tier 1 health potion to CrimsonSentinel')>>
    <<elseif $enemyHitPlayer === "ShadowScythe" && $hpPOT >= 1>>
        <<set $NPCs.ShadowScythe.CurHP += 50>>
        <<set $hpPOT -= 1>>
        <<run $combat_log.push('You gave a tier 1 health potion to ShdaowScythe')>>
    <<elseif $enemyHitPlayer === "Zegrath" && $hpPOT >= 1>>
        <<set $NPCs.Zegrath.CurHP += 50>>
        <<set $hpPOT -= 1>>
        <<run $combat_log.push('You gave a tier 1 health potion to Zegrath')>>
    <<elseif $hpPOT <= 1>>
        <<run $combat_log.push('You dont have any tier 1 health potions')>>
    <</if>>
<</if>>
