	<</if>>
<<elseif $killedPKers >= 85>>
	<<if $lootchance lte 20>>
		<<BloodlustGain>>
	<</if>>
<<elseif $killedPKers >= 70>>
	<<if $lootchance lte 12>>
		<<BloodlustGain>>
	<</if>>
<<elseif $killedPKers >= 50>>
	<<if $lootchance lte 8>>
		<<BloodlustGain>>
	<</if>>
<<elseif $killedPKers >= 30>>
	<<if $lootchance lte 5>>
		<<BloodlustGain>>
	<</if>>
<</if>>
<<goto $lastVisitedPassage>>
<</link>>
<</replace>><</link>>
