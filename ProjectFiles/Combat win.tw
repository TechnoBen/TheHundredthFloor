:: Combat win {"position":"200,2075","size":"100,100"}
--| Congratulations! |--
Col: <<= $combatCol.toFixed(0)>> | XP: <<= $combatXP.toFixed(0)>>
Items: <<= $combat_drops>>
<<EventCurrencies>>\
<<link "Continue">>
    <<set $turnChanceCur to $turnChanceMax>>
    <<set $NPCs.RadiantRose.turnChanceCur to $NPCs.RadiantRose.turnChanceMax>>
    <<set $NPCs.ShadowScythe.turnChanceCur to $NPCs.ShadowScythe.turnChanceMax>>
    <<set $NPCs.CrimsonSentinel.turnChanceCur to $NPCs.CrimsonSentinel.turnChanceMax>>
    <<set $NPCs.Zegrath.turnChanceCur to $NPCs.Zegrath.turnChanceMax>>
    <<unset $bonusTurnPlayer>>
    <<unset $bonusTurnRadiantRose>>
    <<unset $bonusTurnShadowScythe>>
    <<unset $bonusTurnCrimsonSentinel>>
    <<unset $bonusTurnZegrath>>
    <<set $combat_drops = []>>
    <<set $combatCol to 0>>
    <<set $combatXP to 0>>
    <<set $combat_log = []>>
	<<set $bleedPotency to 0>>
	<<set $bleedCountCur to 0>>
	<<set $NPCs.RadiantRose.bleedPotency to 0>>
	<<set $NPCs.RadiantRose.bleedCountCur to 0>>
	<<set $NPCs.ShadowScythe.bleedPotency to 0>>
	<<set $NPCs.ShadowScythe.bleedCountCur to 0>>
	<<set $NPCs.CrimsonSentinel.bleedPotency to 0>>
	<<set $NPCs.CrimsonSentinel.bleedCountCur to 0>>
	<<set $NPCs.Zegrath.bleedPotency to 0>>
	<<set $NPCs.Zegrath.bleedCountCur to 0>>

    <<set $critChance -= $PoisePotency>>
	<<set $PoisePotency to 0>>
    <<set $critDMG -= $PoiseCount/10>>
	<<set $PoiseCount to 0>>
    <<set $NPCs.RadiantRose.CritChance -= $NPCs.RadiantRose.PoisePotency>>
	<<set $NPCs.RadiantRose.PoisePotency to 0>>
    <<set $NPCs.RadiantRose.CritDMG -= $NPCs.RadiantRose.PoiseCount/10>>
	<<set $NPCs.RadiantRose.PoiseCount to 0>>
    <<set $NPCs.ShadowScythe.CritChance -= $NPCs.ShadowScythe.PoisePotency>>
	<<set $NPCs.ShadowScythe.PoisePotency to 0>>
    <<set $NPCs.ShadowScythe.CritDMG -= $NPCs.ShadowScythe.PoiseCount/10>>
	<<set $NPCs.ShadowScythe.PoiseCount to 0>>
    <<set $NPCs.CrimsonSentinel.CritChance -= $NPCs.CrimsonSentinel.PoisePotency>>
	<<set $NPCs.CrimsonSentinel.PoisePotency to 0>>
    <<set $NPCs.CrimsonSentinel.CritDMG -= $NPCs.CrimsonSentinel.PoiseCount/10>>
	<<set $NPCs.CrimsonSentinel.PoiseCount to 0>>
    <<set $NPCs.Zegrath.CritChance -= $NPCs.Zegrath.PoisePotency>>
	<<set $NPCs.Zegrath.PoisePotency to 0>>
    <<set $NPCs.Zegrath.CritDMG -= $NPCs.Zegrath.PoiseCount/10>>
	<<set $NPCs.Zegrath.PoiseCount to 0>>

    <<set $DEFPercentBuff -= $DefenseUpPotency>>
    <<set $DefenseUpCount -= $DefenseUpCount>>
    <<set $DefenseUpPotency -= $DefenseUpPotency>>
    <<set $NPCs.RadiantRose.DEFPercentBuff -= $NPCs.RadiantRose.DefenseUpPotency>>
    <<set $NPCs.RadiantRose.DefenseUpCount -= $NPCs.RadiantRose.DefenseUpCount>>
    <<set $NPCs.RadiantRose.DefenseUpPotency -= $NPCs.RadiantRose.DefenseUpPotency>>
    <<set $NPCs.ShadowScythe.DEFPercentBuff -= $NPCs.ShadowScythe.DefenseUpPotency>>
    <<set $NPCs.ShadowScythe.DefenseUpCount -= $NPCs.ShadowScythe.DefenseUpCount>>
    <<set $NPCs.ShadowScythe.DefenseUpPotency -= $NPCs.ShadowScythe.DefenseUpPotency>>
    <<set $NPCs.CrimsonSentinel.DEFPercentBuff -= $NPCs.CrimsonSentinel.DefenseUpPotency>>
    <<set $NPCs.CrimsonSentinel.DefenseUpCount -= $NPCs.CrimsonSentinel.DefenseUpCount>>
    <<set $NPCs.CrimsonSentinel.DefenseUpPotency -= $NPCs.CrimsonSentinel.DefenseUpPotency>>
    <<set $NPCs.Zegrath.DEFPercentBuff -= $NPCs.Zegrath.DefenseUpPotency>>
    <<set $NPCs.Zegrath.DefenseUpPotency -= $NPCs.Zegrath.DefenseUpPotency>>
    <<set $NPCs.Zegrath.DefenseUpCount -= $NPCs.Zegrath.DefenseUpCount>>

    <<set $DEFPercentBuff += $DefenseDownPotency>>
    <<set $DefenseDownCount -= $DefenseDownCount>>
    <<set $DefenseDownPotency -= $DefenseDownPotency>>
    <<set $NPCs.RadiantRose.DEFPercentBuff += $NPCs.RadiantRose.DefenseDownPotency>>
    <<set $NPCs.RadiantRose.DefenseDownCount -= $NPCs.RadiantRose.DefenseDownCount>>
    <<set $NPCs.RadiantRose.DefenseDownPotency -= $NPCs.RadiantRose.DefenseDownPotency>>
    <<set $NPCs.ShadowScythe.DEFPercentBuff += $NPCs.ShadowScythe.DefenseDownPotency>>
    <<set $NPCs.ShadowScythe.DefenseDownCount -= $NPCs.ShadowScythe.DefenseDownCount>>
    <<set $NPCs.ShadowScythe.DefenseDownPotency -= $NPCs.ShadowScythe.DefenseDownPotency>>
    <<set $NPCs.CrimsonSentinel.DEFPercentBuff += $NPCs.CrimsonSentinel.DefenseDownPotency>>
    <<set $NPCs.CrimsonSentinel.DefenseDownCount -= $NPCs.CrimsonSentinel.DefenseDownCount>>
    <<set $NPCs.CrimsonSentinel.DefenseDownPotency -= $NPCs.CrimsonSentinel.DefenseDownPotency>>
    <<set $NPCs.Zegrath.DEFPercentBuff += $NPCs.Zegrath.DefenseDownPotency>>
    <<set $NPCs.Zegrath.DefenseDownPotency -= $NPCs.Zegrath.DefenseDownPotency>>
    <<set $NPCs.Zegrath.DefenseDownCount -= $NPCs.Zegrath.DefenseDownCount>>

    <<set $DazedCount -= $DazedCount>>
    <<set $DazedPotency -= $DazedPotency>>
    <<set $StunnedCount -= $StunnedCount>>
    <<set $NPCs.RadiantRose.DazedCount -= $NPCs.RadiantRose.DazedCount>>
    <<set $NPCs.RadiantRose.DazedPotency -= $NPCs.RadiantRose.DazedPotency>>
    <<set $NPCs.RadiantRose.StunnedCount -= $NPCs.RadiantRose.StunnedCount>>
    <<set $NPCs.ShadowScythe.DazedCount -= $NPCs.ShadowScythe.DazedCount>>
    <<set $NPCs.ShadowScythe.DazedPotency -= $NPCs.ShadowScythe.DazedPotency>>
    <<set $NPCs.ShadowScythe.StunnedCount -= $NPCs.ShadowScythe.StunnedCount>>
    <<set $NPCs.CrimsonSentinel.DazedCount -= $NPCs.CrimsonSentinel.DazedCount>>
    <<set $NPCs.CrimsonSentinel.DazedPotency -= $NPCs.CrimsonSentinel.DazedPotency>>
    <<set $NPCs.CrimsonSentinel.StunnedCount -= $NPCs.CrimsonSentinel.StunnedCount>>
    <<set $NPCs.Zegrath.DazedCount -= $NPCs.Zegrath.DazedCount>>
    <<set $NPCs.Zegrath.DazedPotency -= $NPCs.Zegrath.DazedPotency>>
    <<set $NPCs.Zegrath.StunnedCount -= $NPCs.Zegrath.StunnedCount>>

    <<set $FlowCount -= $FlowCount>>
    <<set $turnChanceMax -= $FlowPotency>>
    <<set $FlowPotency -= $FlowPotency>>
    <<set $NPCs.RadiantRose.FlowCount -= $NPCs.RadiantRose.FlowCount>>
    <<set $NPCs.RadiantRose.turnChanceMax -= $NPCs.RadiantRose.FlowPotency>>
    <<set $NPCs.RadiantRose.FlowPotency -= $NPCs.RadiantRose.FlowPotency>>
    <<set $NPCs.ShadowScythe.FlowCount -= $NPCs.ShadowScythe.FlowCount>>
    <<set $NPCs.ShadowScythe.turnChanceMax -= $NPCs.ShadowScythe.FlowPotency>>
    <<set $NPCs.ShadowScythe.FlowPotency -= $NPCs.ShadowScythe.FlowPotency>>
    <<set $NPCs.CrimsonSentinel.FlowCount -= $NPCs.CrimsonSentinel.FlowCount>>
    <<set $NPCs.CrimsonSentinel.turnChanceMax -= $NPCs.CrimsonSentinel.FlowPotency>>
    <<set $NPCs.CrimsonSentinel.FlowPotency -= $NPCs.CrimsonSentinel.FlowPotency>>
    <<set $NPCs.Zegrath.FlowCount -= $NPCs.Zegrath.FlowCount>>
    <<set $NPCs.Zegrath.turnChanceMax -= $NPCs.Zegrath.FlowPotency>>
    <<set $NPCs.Zegrath.FlowPotency -= $NPCs.Zegrath.FlowPotency>>

    <<set $poisonCountCur to 0>>
    <<set $poisonPotency to 0>>
    <<set $NPCs.RadiantRose.poisonCountCur to 0>>
	<<set $NPCs.RadiantRose.poisonPotency to 0>>
	<<set $NPCs.ShadowScythe.poisonCountCur to 0>>
	<<set $NPCs.ShadowScythe.poisonPotency to 0>>
	<<set $NPCs.CrimsonSentinel.poisonCountCur to 0>>
	<<set $NPCs.CrimsonSentinel.poisonPotency to 0>>
	<<set $NPCs.Zegrath.poisonCountCur to 0>>
	<<set $NPCs.Zegrath.poisonPotency to 0>>

    <<if $CDThroatSlit>>
        <<unset $CDThroatSlit>>
    <</if>>
    <<if $CDLeapingSlash>>
        <<unset $CDLeapingSlash>>
    <</if>>
    <<if $CDMultistrike>>
        <<unset $CDMultistrike>>
    <</if>>
    <<if $CDMultistrikeRadiant>>
        <<unset $CDMultistrikeRadiant>>
    <</if>>
    <<if $CDBrace>>
        <<unset $CDBrace>>
    <</if>>
    <<if $CDBraceCrim>>
        <<unset $CDBraceCrim>>
    <</if>>
    <<if $CDPunctureSS>>
        <<unset $CDPunctureSS>>
    <</if>>
    <<if $CDUpperCut>>
        <<unset $CDUpperCut>>
    <</if>>
    <<if $CDConcussion>>
        <<unset $CDConcussion>>
    <</if>>
    <<if $CDUnfocusedStrike>>
        <<unset $CDUnfocusedStrike>>
    <</if>>
    <<if $CDUnfocusedStrikeZeg>>
        <<unset $CDUnfocusedStrikeZeg>>
    <</if>>

    <<if settings.turns == true>>
    	<<set $turns to 1>>
        <<run $combat_log.push('<span class="turnCount">--| TURN ' + $turns + ' |--</span>')>>
    <</if>>
    <<goto $lastVisitedPassage>>
<</link>>


