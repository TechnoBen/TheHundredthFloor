		}
      	if(typeof variables.christmasEvent === 'true') {
			variables.christmasEvent = false;
		} 
      
      	// Everything else goes here
		if(typeof variables.curFatigue === 'undefined') {
			variables.curFatigue = 0;
		} 
		if(typeof variables.maxFatigue === 'undefined') {
			variables.maxFatigue = 1250;
		} 
