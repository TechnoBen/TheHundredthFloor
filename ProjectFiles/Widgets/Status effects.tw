		<<set $NPCs.ShadowScythe.STRPercentBuff -= $NPCs.ShadowScythe.PowerUpPotency>>
		<<set $NPCs.ShadowScythe.PowerUpPotency /= 2>>
		<<set $NPCs.ShadowScythe.STRPercentBuff += $NPCs.ShadowScythe.PowerUpPotency>>
	<</if>>

<</widget>>

