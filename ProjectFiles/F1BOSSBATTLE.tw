<<set $CurHPRadiantRose -= 1>>
<</if>>
<</if>>
<<if $armorDEF + $DEF < 133>>
<<set $CurHP -= 133 - $DEF - $armorDEF>>
<<elseif $armorDEF + $DEF >= 133>>
<<set $CurHP -= 1>>
<</if>>
<<dateadd '1m'>>

