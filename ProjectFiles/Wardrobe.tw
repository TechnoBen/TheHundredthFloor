<<set $inventory.copperSword = clone(setup.weapons.copperSword)>>
<</link>>
<<link [[Starter Sword|Wardrobe]]>>
<<set $inventory.copperSword = clone(setup.weapons.starterSword)>>
<</link>>
<<link [[Bread|Wardrobe]]>>
  <<if !$inventory.boarMeat >>
    <<set $inventory.boarMeat = clone(setup.items.boarMeat)>>
    <<set $inventory.boarMeat.count += 1>>
  <<else>>
    <<set $inventory.boarMeat.count += 1>>
  <</if>>
<</link>>

<<link "Clear filters">> 
  <<set $invFilters to ["None"]>>
  <<goto "Wardrobe">>
<</link>>
<<link "Filter to edible">> 
  <<set $invFilters to ["edible"]>>
  <<goto "Wardrobe">>
<</link>>

<<for _i, _value range $inventory>>
<<if $invFilters.includes("None") or $inventory[_i].tags.includes($invFilters)>><<hovertip "$inventory[_i].description">><<= $inventory[_i].name>><</hovertip>> <<if $inventory[_i].count>>($inventory[_i].count)<</if>>: <<if $inventory[_i].tags.includes("weapon")>><<link "Equip sword">>
<<for _i, _value range $inventory>>
  <<set $player.rightHand to $inventory[_i].sprite>>
  <<goto "Wardrobe">>
<</for>>
<</link>> | <</if>><<if $inventory[_i].tags.includes("armor")>><<link "Equip armor">>
<<for _i, _value range $inventory>>
  <<if $inventory[_i].tags.includes("helmet")>>
  <<elseif $inventory[_i].tags.includes("chestplate")>>
    <<set $player.chestplateLHand to $inventory[_i].spriteLHand>>
    <<set $player.chestplate to $inventory[_i].sprite>>
    <<set $player.chestplateRHand to $inventory[_i].spriteRHand>>
  <<elseif $inventory[_i].tags.includes("leggings")>>
  <<elseif $inventory[_i].tags.includes("boots")>>
  <</if>>
  <<goto "Wardrobe">>
<</for>>
<</link>> | <</if>><<if $inventory[_i].tags.includes("edible")>><<link "Eat item">>

<</link>> | <</if>><<capture _i>><<link "Discard item">>
  <<run delete $inventory[_i]>>
  <<goto "Wardrobe">>
<</link>><</capture>><</if>>
<</for>>