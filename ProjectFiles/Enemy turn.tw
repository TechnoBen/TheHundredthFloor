/* Brace for impact */
<<if $attack is "Brace for impact">>
    <<if $enemyHitPlayer === "Player" && $curStamina >= 25>>
        <<set $curStamina -= 25>>
        <<set $curHunger -= 10>>
        <<set $curFatigue += 5>>
        <<set $DefenseUpCount += 4>>
        <<set $DefenseUpPotency += 0.25>>
        <<set $DEFPercentBuff += 0.25>>
        <<set $CDBrace to 6>>
        <<run $combat_log.push($gamename + ' raises their shield, bracing themselves for impact.')>>
    <<elseif $enemyHitPlayer === "RadiantRose" && $curStamina >= 25>>
        <<set $curStamina -= 25>>
        <<set $curHunger -= 10>>
        <<set $curFatigue += 5>>
        <<set $NPCs.RadiantRose.DefenseUpCount += 4>>
        <<set $NPCs.RadiantRose.DefenseUpPotency += 0.25>>
        <<set $NPCs.RadiantRose.DEFPercentBuff += 0.25>>
        <<set $CDBrace to 6>>
        <<run $combat_log.push($gamename + ' raises their shield, bracing RadiantRose for impact.')>>
    <<elseif $enemyHitPlayer === "CrimsonSentinel" && $curStamina >= 25>>
        <<set $curStamina -= 25>>
        <<set $curHunger -= 10>>
        <<set $curFatigue += 5>>
        <<set $NPCs.CrimsonSentinel.DefenseUpCount += 4>>
        <<set $NPCs.CrimsonSentinel.DefenseUpPotency += 0.25>>
        <<set $NPCs.CrimsonSentinel.DEFPercentBuff += 0.25>>
        <<set $CDBrace to 6>>
        <<run $combat_log.push($gamename + ' raises their shield, bracing CrimsonSentinel for impact.')>>
    <<elseif $enemyHitPlayer === "ShadowScythe" && $curStamina >= 25>>
        <<set $curStamina -= 25>>
        <<set $curHunger -= 10>>
        <<set $curFatigue += 5>>
        <<set $NPCs.ShadowScythe.DefenseUpCount += 4>>
        <<set $NPCs.ShadowScythe.DefenseUpPotency += 0.25>>
        <<set $NPCs.ShadowScythe.DEFPercentBuff += 0.25>>
        <<set $CDBrace to 6>>
        <<run $combat_log.push($gamename + ' raises their shield, bracing ShadowScythe for impact.')>>
    <<elseif $enemyHitPlayer === "Zegrath" && $curStamina >= 25>>
        <<set $curStamina -= 25>>
        <<set $curHunger -= 10>>
        <<set $curFatigue += 5>>
        <<set $NPCs.Zegrath.DefenseUpCount += 4>>
        <<set $NPCs.Zegrath.DefenseUpPotency += 0.25>>
        <<set $NPCs.Zegrath.DEFPercentBuff += 0.25>>
        <<set $CDBrace to 6>>
        <<run $combat_log.push($gamename + ' raises their shield, bracing Zegrath for impact.')>>
    <<elseif $curStamina <= 24>>
        <<run $combat_log.push($gamename + ' is too tired for this action.')>>
    <</if>>
<</if>>
