:: Buy weapons 1 [no-fainting-or-hunger no-party-time-loss] {"position":"1975,2650","size":"100,100"}
<center>\
<div class="cols">\
    <div class="col1">\
        <div class="border1">\
	        <div class="paperdoll">\
    		    <img src = "Textures/Body/Mannequin.png" style="transform: translate(-20px);" />\
                <img class="sword" src = "Textures/weapons/coppersword.png" style="transform: translate(-119px)" />\
    	    </div>\
        </div>\
        <div class="border2">\
            Copper sword:
            Slash DMG + 2
            Pierce DMG + 0.5
        </div>\
        <div class="border1">\
            <<link "Buy the sword | 132 col">>
                <<if $Coins >= 132>> 
                    <<set $sword1 to true>>
                    <<set $Coins -= 132>>
                    <<notify>> You bought a copper sword! <</notify>>
                    <<goto "Buy weapons 1">>
                <<elseif $Coins <= 131>>
                    <<script>>
                        UI.alert("You dont have enough col!");
                    <</script>>
                <</if>>
             <</link>>
        </div>\
    </div>\
