                    <<run $combat_log.push('CRITICAL HIT! Zegrath stabs ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + ' damage')>>
                <<else>>
                    <<set $NPCs.Zegrath.baseDMG to ((kitsuneRNG((50*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG))/100, (75*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG)/100)) * $NPCs.Zegrath.CritDMG) * $NPCs.Zegrath.STRPercentBuff) * $mobs[_i].SlashDEF>>
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>> 
                    <<set $NPCs.Zegrath.CurSTM -= 12>>
					<<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt*2>>
					<<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt*2>>
					<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
					<<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('CRITICAL HIT! Zegrath stabs ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + ' damage')>>
                <</if>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusZegrath>>
        <<elseif $NPCs.Zegrath.CurSTM<= 11>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
            <<run $combat_log.push('Zegrath is too tired to fight so he does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackZegrath is "Slash">>
        <<if $NPCs.Zegrath.CurSTM >= 15>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitZegrath === _i>>
            <<if $NPCs.Zegrath.CritChance <= _critChanceRNGZegrath>>
                <<if $ZegrathFireSword >= 1>>
                    <<set $NPCs.Zegrath.baseDMG to (kitsuneRNG(($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG), (125*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG)/100)) * $NPCs.Zegrath.STRPercentBuff) * $mobs[_i].SlashDEF>>
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
                    <<set $NPCs.Zegrath.CurSTM -= 12>>
                    <<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt>>
					<<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt>>
					<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt/2>>
					<<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt/4 * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('Zegrath slashes ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + ' damage')>>
                <<else>>
                    <<set $NPCs.Zegrath.baseDMG to (kitsuneRNG((50*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG))/100, (75*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG)/100)) * $NPCs.Zegrath.STRPercentBuff) * $mobs[_i].SlashDEF>> 
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
                    <<set $NPCs.Zegrath.CurSTM -= 12>>
					<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
					<<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('Zegrath slashes ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + ' damage')>>
                <</if>>
            <<else>>
                <<if $ZegrathFireSword >= 1>>
                    <<set $NPCs.Zegrath.baseDMG to ((kitsuneRNG(($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG), (125*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG)/100)) * $NPCs.Zegrath.CritDMG) * $NPCs.Zegrath.STRPercentBuff) * $mobs[_i].SlashDEF>>
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
                    <<set $NPCs.Zegrath.CurSTM -= 12>>
                    <<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt*2>>
					<<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt*2>>
					<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
					<<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt/2 * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('CRITICAL HIT! Zegrath slashes ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + ' damage')>>
                <<else>>
                    <<set $NPCs.Zegrath.baseDMG to ((kitsuneRNG((50*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG))/100, (75*($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG)/100)) * $NPCs.Zegrath.CritDMG) * $NPCs.Zegrath.STRPercentBuff) * $mobs[_i].SlashDEF>> 
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>> 
                    <<set $NPCs.Zegrath.CurSTM -= 12>>
					<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt*1.5>>
					<<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt*1.5 * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('CRITICAL HIT! Zegrath slashes ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + ' damage')>>
                <</if>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusZegrath>>
        <<elseif $NPCs.Zegrath.CurSTM<= 14>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
            <<run $combat_log.push('Zegrath is too tired to fight so he does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackZegrath is "FireSword">>
        <<if $NPCs.Zegrath.CurSTM >= 40>>
            <<set $NPCs.Zegrath.CurSTM -= 40>>
            <<set $ZegrathFireSword += 10>>
            <<run $combat_log.push('Zegrath sets his swords on fire!')>>
        <<elseif $NPCs.Zegrath.CurSTM <= 39>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
        <</if>>
    <</if>>
<</if>>

/* Black wolf attacks */
<<if $partyMembers.includes($NPCs.BlackWolf.name)>>
	<<if $NPCs.BlackWolf.CurSTM >= 10 && $NPCs.BlackWolf.timeOut <= 0>>
    	<<set _randomHitBlackWolf to random(0, $mobs.length - 1)>>
      	<<set $NPCs.BlackWolf.baseDMG to ($NPCs.BlackWolf.SlashSTR) * $mobs[_randomHitBlackWolf].BluntDEF>>
    	<<set $mobs[_randomHitBlackWolf].CurHP -= $NPCs.BlackWolf.baseDMG>>
      	<<set $NPCs.BlackWolf.dmgDealtTotal += $NPCs.BlackWolf.baseDMG>>
      	<<set $NPCs.BlackWolf.CurSTM -= 10>>
		<<set $mobs[_i].bleedCountCur += $NPCs.BlackWolf.bleedCountDealt>>
		<<set $mobs[_i].bleedPotency += $NPCs.BlackWolf.bleedPotencyDealt * $mobs[_i].bleedDef>>
    	<<run $combat_log.push($NPCs.BlackWolf.name + ' slashes at the '+ $mobs[_randomHitBlackWolf].name + ' with her nails, dealing ' + $NPCs.BlackWolf.baseDMG.toFixed(2) + ' damage!')>>
    <<elseif $NPCs.BlackWolf.CurSTM >= 0 && $NPCs.BlackWolf.timeOut >= 1>>
    	<<set $NPCs.BlackWolf.CurSTM += $NPCs.BlackWolf.INT>>
      	<<set $NPCs.BlackWolf.timeOut -= 1>>
    <<elseif $NPCs.BlackWolf.timeOut <= 0 && $NPCs.BlackWolf.CurSTM <= 10>>
    	<<run $combat_log.push($NPCs.BlackWolf.name + ' needs to rest for a bit.')>>
		<<set $NPCs.BlackWolf.timeOut to kitsuneRNG(5, 12)>>
    	<<set $NPCs.BlackWolf.CurSTM += $NPCs.BlackWolf.INT>>
    <</if>>
<</if>>

<<burnPlayer>>
<<bleedTrigger>>
<<PowerUpCount>>

/* Player death */
<<if $CurHP lte 0>>
    <<goto "lose">>
<</if>>

/* Party death*/
<<if $NPCs.RadiantRose.CurHP lte 0 && $partyMembers.includes("RadiantRose")>>
    <<set $NPCs.RadiantRose.Affection to 0>>
    <<run $partyMembers.delete("RadiantRose")>>
    <<run $combat_log.push('RadiantRose escapes and leaves your party.')>>
    <<MemberEscape>>
    <<set $CurFear += (25 - ($FearPercentBuff*25/100) + ($FearPercentDebuff*25/100))>>
<</if>>
<<if $NPCs.ShadowScythe.CurHP lte 0 && $partyMembers.includes("ShadowScythe")>>
    <<set $NPCs.ShadowScythe.Affection to 0>>
    <<run $partyMembers.delete("ShadowScythe")>>
    <<run $combat_log.push('ShadowScythe escapes and leaves your party.')>>
    <<MemberEscape>>
    <<set $CurFear += (25 - ($FearPercentBuff*25/100) + ($FearPercentDebuff*25/100))>>
<</if>>
<<if $NPCs.CrimsonSentinel.CurHP lte 0 && $partyMembers.includes("CrimsonSentinel")>> 
    <<set $NPCs.CrimsonSentinel.Affection to 0>>
    <<run $partyMembers.delete("CrimsonSentinel")>>
    <<run $combat_log.push('CrimsonSentinel escapes and leaves your party.')>>
    <<MemberEscape>>
    <<set $CurFear += (25 - ($FearPercentBuff*25/100) + ($FearPercentDebuff*25/100))>>
<</if>>
<<if $NPCs.BlackWolf.CurHP lte 0 && $partyMembers.includes($NPCs.BlackWolf.name)>>
	<<set $NPCs.BlackWolf.Dead to true>> 
	<<run $partyMembers.delete($NPCs.BlackWolf.name)>>
    <<run $combat_log.push($NPCs.BlackWolf.name + ' died.')>>
    <<set $NPCs.Zegrath.Affection -= 100>>
    <<Deaths>>
    <<set $CurFear += (50 - ($FearPercentBuff*50/100) + ($FearPercentDebuff*50/100))>>
<</if>>
<<if $NPCs.Zegrath.CurHP lte 0 && $partyMembers.includes("Zegrath")>> 
    <<set $NPCs.Zegrath.Dead to true>>
    <<run $partyMembers.delete("Zegrath")>>
    <<run $combat_log.push('Zegrath died.')>>
    <<Deaths>>
    <<set $CurFear += (50 - ($FearPercentBuff*50/100) + ($FearPercentDebuff*50/100))>>
<</if>>

/* Ring effects */
<<for _i = 1; _i lte 10; _i++>>
    <<if State.variables["Finger" + _i] is "Ring of the living">>
      <<set $CurHP += $dmgDealt.Combat / 3>>
    <</if>>
<</for>>

/* Attack text */
<<set $attacktxt to random(100)>>

/* Mobs dying */
<<set _mob = $mobs>>
<<for _i = 0; _i lt $mobs.length; _i++>>
  <<if _mob[_i].CurHP <= 0.01>>
    <<MobRewards>>
    <<run $combat_log.push('Level ' + $mobs[_i].lvl + ' ' + $mobs[_i].name + ' has been slain.')>>
  	<<run $mobs.deleteAt(_i)>>
  <</if>>
<</for>>

/* Bonus turn */
<<set $turnChanceCur -= 100>>
<<set _bonusTurnRNG to random(100)>>
<<if $turnChanceCur > _bonusTurnRNG>>
    <<set _bonusTurn to true>>
    <<set $bonusTurnPlayer to true>>
<</if>>

<<if $partyMembers.includes("RadiantRose")>>
    <<set $NPCs.RadiantRose.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.RadiantRose.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnRadiantRose to true>>
    <</if>>
<</if>>

<<if $partyMembers.includes("ShadowScythe")>>
    <<set $NPCs.ShadowScythe.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.ShadowScythe.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnShadowScythe to true>>
    <</if>>
<</if>>

<<if $partyMembers.includes("CrimsonSentinel")>>
    <<set $NPCs.CrimsonSentinel.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.CrimsonSentinel.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnCrimsonSentinel to true>>
    <</if>>
<</if>>

<<if $partyMembers.includes("Zegrath")>>
    <<set $NPCs.Zegrath.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.Zegrath.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnZegrath to true>>
    <</if>>
<</if>>

/* Bonus turn mob reset */

<<for _i = 0; _i lt $mobs.length; _i++>>
    <<set _mob[_i].turnChanceCur to _mob[_i].turnChanceMax>>
    <<set _mob[_i].bonusTurn to 0>>
<</for>>

/* Mob selects player/party so it can also announce who is targetting who. Wont do rn. Too many issues. */

/*<<set _npc = $NPCs[_i]>> */
/*<<set _mob = $mobs>> */
/*<<for _i = 0; _i lt $mobs.length; _i++>> */
/*    <<set $randomHit to random(0, $partyMembers.length)>> */
/*    <<set $mobHit to kitsuneRNG(0, 100)>> */
/*    <<if $randomHit <= $partyMembers.length - 1>> */
/*        <<set _npc = $NPCs[$partyMembers[_randomHit]]>> */
/*        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' is targetting ' + _npc.name)>> */
/*    <<else>> */
/*        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' is targetting ' + $gamename)>> */
/*    <</if>> */
/*<</for>> */

<<if _bonusTurn === true>>
	/* Bonus turn activate (obviously) */
    <<goto "Combat remake">>
<<elseif not $mobs.length && $floorBossBattle !== true>>
	/* Combat end here */
	<<goto "Combat win">>
<<elseif $mobs.length >= 1 && $floorBossBattle !== true>>
    <<goto 'Enemy turn'>>
<</if>>

<</link>>
<<link "Run away">>

<<set _escape to kitsuneRNG(1, 100) + $DEX>>
<<set $attackText to "Run fail">>

/* Attack text */
<<set $attacktxt to random(100)>>

<<set _mobsDEX to 0>>
<<set _mob = $mobs>>
<<for _i = 0; _i lt $mobs.length; _i++>>
    <<set _mobsDEX += $mobs[_i].DEX>>
<</for>>

<<if $curStamina >= 30>>
  <<if _escape >= _mobsDEX>>
        <<set $curStamina -= 30>>
        <<set $curFatigue += 25>>
        /* Turns getting fixed for player turn */
        <<set $turnChanceCur to $turnChanceMax>>
        <<set $NPCs.RadiantRose.turnChanceCur to $NPCs.RadiantRose.turnChanceMax>>
        <<set $NPCs.ShadowScythe.turnChanceCur to $NPCs.ShadowScythe.turnChanceMax>>
        <<set $NPCs.CrimsonSentinel.turnChanceCur to $NPCs.CrimsonSentinel.turnChanceMax>>
        <<set $NPCs.Zegrath.turnChanceCur to $NPCs.Zegrath.turnChanceMax>>
        <<unset $bonusTurnPlayer>>
        <<unset $bonusTurnRadiantRose>>
        <<unset $bonusTurnShadowScythe>>
        <<unset $bonusTurnCrimsonSentinel>>
        <<unset $bonusTurnZegrath>>
        <<set $mobs to []>>
        <<set $combat_log to []>>
        <<set $combat_drops = []>>
        <<set $combatCol to 0>>
        <<set $combatXP to 0>>
        /* Bonus turn mob reset */
        <<for _i = 0; _i lt $mobs.length; _i++>>
            <<set _mob[_i].turnChanceCur to _mob[_i].turnChanceMax>>
            <<set _mob[_i].bonusTurn to 0>>
        <</for>>
        <<goto "Run away...">>
	  <<else>>
		<<set $curStamina -= 15>>
    	<<set $curFatigue += 12>>
      <<run $combat_log.push('You tried escaping... You failed.')>>
    	<<goto "Enemy turn">>
	<</if>>
<</if>>
<</link>> | 30 stamina