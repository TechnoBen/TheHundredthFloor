    </label>
    <label>
        <<if $CDConcussion >= 1>> | CD: $CDConcussion <<hovertip `'?b Concussion ?dmg 70%?b ?stm 35 ?onhit Deal damage equal to the amount of ?dazed, then clear all ?dazed ?onhit If enemy has ?stun, deal 30%?b, else inflict 1 ?stun count'` 600>>Concussion<</hovertip>><<else>> | <<radiobutton "$attack" "Concussion">> <<hovertip `'?b Concussion ?dmg 70%?b ?stm 35 ?onhit Deal damage equal to the amount of ?dazed, then clear all ?dazed ?onhit If enemy has ?stun, deal 30%?b, else inflict 1 ?stun count'` 600>>Concussion<</hovertip>><</if>>
    </label>
<</if>>
<<if $weaponType is "Dagger">>
    <label>
         | <<radiobutton "$attack" "Stab">> <<hovertip `'?p Stab ?dmg 75%?p ?stm 5 ?onhit Inflict <<= ($bleedCountDealt).toFixed(2)>> ?bleed count ?onhit Inflict <<= ($bleedPotencyDealt).toFixed(2)>> ?bleed potency'`>>Stab<</hovertip>>
    </label>
    <label>
         | <<radiobutton "$attack" "Mutilate">> <<hovertip `'?p Mutilate ?dmg 100%?p ?stm 12 ?onhit Inflict <<= ($bleedCountDealt * 1.2).toFixed(2)>> ?bleed count ?onhit Inflict <<= ($bleedPotencyDealt * 1.2).toFixed(2)>> ?bleed potency'`>>Mutilate<</hovertip>>
    </label>
    <label>
        <<if $CDThroatSlit >= 1>> | CD: $CDThroatSlit <<hovertip `'?p Throat pierce ?dmg 150%?p ?stm 20 ?onhit Inflict <<= ($bleedCountDealt).toFixed(2)>> ?bleed count ?onhit Inflict <<= ($bleedPotencyDealt).toFixed(2)>> ?bleed potency ?oncrit Does not add ?bleed count ?oncrit Trigger ?bleed, halve count and remove all potency'` 500>>Throat pierce<</hovertip>><<else>> | <<radiobutton "$attack" "Throat pierce">> <<hovertip `'?p Throat pierce ?dmg 150%?p ?stm 20 ?onhit Inflict <<= ($bleedCountDealt).toFixed(2)>> ?bleed count ?onhit Inflict <<= ($bleedPotencyDealt).toFixed(2)>> ?bleed potency ?oncrit Does not add ?bleed count ?oncrit Trigger ?bleed, halve count and remove all potency'` 500>>Throat pierce<</hovertip>><</if>>
    </label>
<</if>>
<</nobr>>
<<nobr>>
Choose who to attack: <<for _i = 0; _i lte 99; _i++>>
    <<capture _i>>
      <<if _i != 0 && $mobs[_i]>>|<</if>>
        <<if $mobs[_i]>>
            <label>
                <<radiobutton "$enemyHitPlayer" _i checked>> $mobs[_i].name
            </label>
     	<</if>>
    <</capture>>
<</for>>
<</nobr>>
<</if>>\
<<for _i = 0; _i lte 99; _i++>>\
<<capture _i>>\
<<if $partyMembers[_i] == "RadiantRose">>\
<<if $NPCs.RadiantRose.turnChanceCur >= 0.01>><<if $bonusTurnRadiantRose === true>>EXTRA TURN! <</if>>Select <span class="radiant">RadiantRose</span>'s attack: <label><<radiobutton "$attackRadiantRose" "Do nothing" checked>> Do nothing</label> | <label><<radiobutton "$attackRadiantRose" "Stab">> <<hovertip `'?p Stab ?dmg 100%?p ?stm 6 ?onhit Inflict <<= ($NPCs.RadiantRose.bleedCountDealt/1.5).toFixed(2)>> ?bleed count ?onhit Inflict <<= ($NPCs.RadiantRose.bleedPotencyDealt/2).toFixed(2)>> ?bleed potency'`>>Stab<</hovertip>></label> | <label><<radiobutton "$attackRadiantRose" "Charge">> <<hovertip `'?p Charge ?dmg 100%?p + 50% DEX ?stm 10 ?onhit Inflict <<= ($NPCs.RadiantRose.bleedCountDealt).toFixed(2)>> ?bleed count ?onhit Inflict <<= ($NPCs.RadiantRose.bleedPotencyDealt).toFixed(2)>> ?bleed potency'`>>Charge<</hovertip>></label><label><<if $CDMultistrikeRadiant >= 1>> | CD: $CDMultistrikeRadiant <<hovertip `'?p Multi strike ?dmg 100%?p + 50% DEX ?stm 20 ?onuse Repeat 3 times + 1 more for each 10 DEX ?onhit Gain 1 ?poise count ?onhit Gain 5 ?poise potency'` 400>>Multi strike<</hovertip>><<else>> | <<radiobutton "$attackRadiantRose" "Multi strike">> <<hovertip `'?p Multi strike ?dmg 100%?p + 50% DEX ?stm 20 ?onuse Repeat 3 times + 1 more for each 10 DEX ?onhit Gain 1 ?poise count ?onhit Gain 5 ?poise potency'` 400>>Multi strike<</hovertip>><</if>></label>
<<nobr>>
Choose who <span class="radiant">RadiantRose</span> attacks: <<for _i = 0; _i lte 99; _i++>>
    <<capture _i>>
      <<if _i != 0 && $mobs[_i]>>|<</if>>
        <<if $mobs[_i]>>
            <label>
                <<radiobutton "$enemyHitRadiantRose" _i checked>> $mobs[_i].name
            </label>
