:: PassageFooter {"position":"1875,100","size":"100,100"}
<<nobr>>
<<if !tags().includesAny('player-turn', 'enemy-turn')>>
<<if $waterTime1 >= 1>>
<<if $plantType1 !== "Nothing">>
	<<set _rngWater to random(1,3)>>
    <<set _rngGrowth to random(1,8)>>
	<<set $waterTime1 -= _rngWater>>
    <<set $timeTillGrowth1 -= _rngGrowth>>
<</if>>
<</if>>
<<if $waterTime2 >= 1>>
<<if $plantType2 !== "Nothing">>
	<<set _rngWater to random(1,3)>>
    <<set _rngGrowth to random(1,8)>>
	<<set $waterTime2 -= _rngWater>>
    <<set $timeTillGrowth2 -= _rngGrowth>>
<</if>>
<</if>>
<<if $waterTime3 >= 1>>
<<if $plantType3 !== "Nothing">>
	<<set _rngWater to random(1,3)>>
    <<set _rngGrowth to random(1,8)>>
	<<set $waterTime3 -= _rngWater>>
    <<set $timeTillGrowth3 -= _rngGrowth>>
<</if>>
<</if>>
<</if>>

<<if !tags().includesAny('player-turn' , 'enemy-turn' , 'no-fainting-or-hunger') && $curFatigue >= (99*$maxFatigue)/100>>
	<<set $curStamina -= 1 + $INT*1.5>>
	<<set $NPCs.ShadowScythe.CurSTM += 1 + $NPCs.ShadowScythe.INT*1.5>>
	<<set $NPCs.RadiantRose.CurSTM += 1 + $NPCs.RadiantRose.INT*1.5>>
	<<set $NPCs.CrimsonSentinel.CurSTM += 1 + $NPCs.CrimsonSentinel.INT*1.5>>
	<<set $NPCs.Zegrath.CurSTM += 1 + $NPCs.Zegrath.INT*1.5>>
	<<set $NPCs.Marcellus.CurSTM += 1 + $NPCs.Marcellus.INT*1.5>>
<<elseif !tags().includesAny('player-turn' , 'enemy-turn' , 'no-fainting-or-hunger') && $curFatigue >= (75*$maxFatigue)/100>>
	<<set $curStamina += 4/4 + $INT/3>>
	<<set $NPCs.ShadowScythe.CurSTM += 4 + $NPCs.ShadowScythe.INT/3>>
	<<set $NPCs.RadiantRose.CurSTM += 4 + $NPCs.RadiantRose.INT/3>>
	<<set $NPCs.CrimsonSentinel.CurSTM += 4 + $NPCs.CrimsonSentinel.INT/3>>
	<<set $NPCs.Zegrath.CurSTM += 4 + $NPCs.Zegrath.INT/3>>
	<<set $NPCs.Marcellus.CurSTM += 4 + $NPCs.Marcellus.INT/3>>
<<elseif !tags().includesAny('player-turn' , 'enemy-turn' , 'no-fainting-or-hunger') && $curFatigue >= (50*$maxFatigue)/100>>
	<<set $curStamina += 4/3 + $INT/2>>
	<<set $NPCs.ShadowScythe.CurSTM += 4 + $NPCs.ShadowScythe.INT/2>>
	<<set $NPCs.RadiantRose.CurSTM += 4 + $NPCs.RadiantRose.INT/2>>
	<<set $NPCs.CrimsonSentinel.CurSTM += 4 + $NPCs.CrimsonSentinel.INT/2>>
	<<set $NPCs.Zegrath.CurSTM += 4 + $NPCs.Zegrath.INT/2>>
	<<set $NPCs.Marcellus.CurSTM += 4 + $NPCs.Marcellus.INT/2>>
<<elseif !tags().includesAny('player-turn' , 'enemy-turn' , 'no-fainting-or-hunger') && $curFatigue >= (25*$maxFatigue)/100>>
	<<set $curStamina += 4/2 + $INT>>
	<<set $NPCs.ShadowScythe.CurSTM += 4 + $NPCs.ShadowScythe.INT>>
	<<set $NPCs.RadiantRose.CurSTM += 4 + $NPCs.RadiantRose.INT>>
	<<set $NPCs.CrimsonSentinel.CurSTM += 4 + $NPCs.CrimsonSentinel.INT>>
	<<set $NPCs.Zegrath.CurSTM += 4 + $NPCs.Zegrath.INT>>
	<<set $NPCs.Marcellus.CurSTM += 4 + $NPCs.Marcellus.INT>>
<<elseif !tags().includesAny('player-turn' , 'enemy-turn' , 'no-fainting-or-hunger') && $curFatigue >= (0*$maxFatigue)/100>>
	<<set $curStamina += 4 + $INT*1.5*1.5>>
	<<set $NPCs.ShadowScythe.CurSTM += 4 + $NPCs.ShadowScythe.INT*1.5>>
	<<set $NPCs.RadiantRose.CurSTM += 4 + $NPCs.RadiantRose.INT*1.5>>
	<<set $NPCs.CrimsonSentinel.CurSTM += 4 + $NPCs.CrimsonSentinel.INT*1.5>>
	<<set $NPCs.Zegrath.CurSTM += 4 + $NPCs.Zegrath.INT*1.5>>
	<<set $NPCs.Marcellus.CurSTM += 4 + $NPCs.Marcellus.INT*1.5>>
<</if>>

<<if setup.datesystems.default.getDate().d >= $timeRemember.Inn1D && setup.datesystems.default.getDate().h >= $timeRemember.Inn1H>>
	<<set $paidForInn1 to false>>
<</if>>
<<if setup.datesystems.default.getDate().d >= $timeRemember.Inn2D && setup.datesystems.default.getDate().h >= $timeRemember.Inn2H>>
	<<set $paidForInn2 to false>>
<</if>>
<<if setup.datesystems.default.getDate().d >= $timeRemember.Inn3D && setup.datesystems.default.getDate().h >= $timeRemember.Inn3H>>
	<<set $paidForInn3 to false>>
<</if>>

/* Daily related stuff */
<<if setup.datesystems.default.getDate().d >= $timeRemember.Daily>>
	<<if $traits.Bloodlust>>
    	<<set $STRPercentBuff -= $dailyKills/2>> 
    <</if>>
    <<set $dailyKills to 0>> 
<</if>>
<<set $timeRemember.Daily to setup.datesystems.default.getDate().d + 1>>

/* NPC lvl ups */ 

<<if $NPCs.RadiantRose.CurXP >= $NPCs.RadiantRose.MaxXP>>
  <<set _statsNPC to random(1,100)>>
  <<if _statsNPC lte 10>>
    <<set $NPCs.RadiantRose.INT += 1>>
  <<elseif _statsNPC lte 25>>
    <<set $NPCs.RadiantRose.PierceSTR += 1>>
    <<set $NPCs.RadiantRose.CritChance += 0.1>>
  <<elseif _statsNPC lte 45>>
    <<set $NPCs.RadiantRose.PierceDEF += 0.34>>
    <<set $NPCs.RadiantRose.BluntDEF += 0.33>>
    <<set $NPCs.RadiantRose.SlashDEF += 0.33>>
    <<set $NPCs.RadiantRose.bleedDef += $bleedDefGain>>
  <<elseif _statsNPC lte 100>>
    <<set $NPCs.RadiantRose.DEX += 1>>
    <<set $NPCs.RadiantRose.MaxSTM += 25>>
    <<set $NPCs.RadiantRose.turnChanceMax += 0.5>>
    <<set $NPCs.RadiantRose.turnChanceCur += 0.5>>
  <</if>>
  <<set $NPCs.RadiantRose.Level += 1>>
  <<set $NPCs.RadiantRose.CurXP -= $NPCs.RadiantRose.MaxXP>>
  <<set $NPCs.RadiantRose.MaxHP += 50>>
  <<set $NPCs.RadiantRose.CurHP = $NPCs.RadiantRose.MaxHP>>
  <<set $NPCs.RadiantRose.MaxXP *= $XPmodifier>>
<</if>>

<<if $NPCs.ShadowScythe.CurXP >= $NPCs.ShadowScythe.MaxXP>>
