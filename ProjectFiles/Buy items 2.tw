:: Buy items 2 [no-fainting-or-hunger no-party-time-loss] {"position":"3525,1850","size":"100,100"}
<<nobr>><h2>Potions:</h2><</nobr>>
<<button "Buy a tier 1 health potion | 48 col">>
<<if $Coins >= 48>> 
<<set $hpPOT += 1>>
<<notify>> You bought a tier 1 health potion! <</notify>>
<<goto "Buy items 2">>
<<set $Coins -= 48>>
<<elseif $Coins <= 47>>
<<script>>
UI.alert("You dont have enough col!");
<</script>>
<</if>>
<</button>>
