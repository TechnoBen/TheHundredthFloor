/* Party moves */

/* RadiantRose */
<<if $partyMembers.includes("RadiantRose")>>
/* Doing nothing */
<<if $attackRadiantRose === "Do nothing">>
    <<run $combat_log.push('RadiantRose does nothing.')>>
<</if>>
/* Blocking */
<<if $attackRadiantRose === "Block">>
    <<if $NPCs.RadiantRose.CurSTM >= 8>>
        <<run $combat_log.push('RadiantRose gets into a blocking stance.')>>
        <<set $NPCs.RadiantRose.CurSTM -= 8>>
        <<set $NPCs.RadiantRose.blockingModifier to 0.5>>
    <<else>>
        <<run $combat_log.push('RadiantRose is too tired to block.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attackRadiantRose === "Dodge">>
