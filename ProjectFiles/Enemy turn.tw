    <<radiobutton "$enemyHitPlayer" "Player" checked>> Myself
</label>
<<for _members range $partyMembers>>
    <<capture _members>>
        <label>
             | <<radiobutton "$enemyHitPlayer" _members>> _members
        </label>
    <</capture>>
<</for>>
<</nobr>>
<<for _i = 0; _i lte 4; _i++>>\
<<capture _i>>\
<<if $partyMembers[_i] === "RadiantRose">>\
