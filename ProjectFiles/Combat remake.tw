<<link "Next">>
/* Player attacks */
/* Doing nothing */
<<if $attack == "Do nothing">>
    <<set _funsies to random(0, 100)>>
    <<if _funsies === 1>>
        <<run $combat_log.push('Exhausted? Tired. Want rest? Hungry. Want out?')>> 
    <<else>>
	    <<run $combat_log.push($gamename + ' does nothing.')>>
    <</if>>
  <<if $curStamina <= $maxStamina >>
    <<set $curStamina += 5 + $INT>>
  <<elseif $curStamina >= $maxStamina>>
    <<set $curStamina -= 5 + $INT>>
  <</if>>
<</if>>
/* Punch */
<<if $attack === "Punch">>
    <<if $curStamina >= 5>>  
        <<set $curStamina -= 5>>
        <<set $curHunger -= 2>>
        <<set $curFatigue += 1>>
        <<for _i = 0; _i lte 99; _i++>>
            <<if $enemyHitPlayer === _i>>
                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                <<if $critChance <= _critChanceRNG>>
                    <<set $baseDMG to ($BluntSTR + $weaponBluntDMG - ($STRPercentDebuff*($BluntSTR + $weaponBluntDMG)/100) + ($STRPercentBuff*($BluntSTR + $weaponBluntDMG)/100)) * $mobs[_i].BluntDEF>>
                    <<set $mobs[_i].CurHP -= $baseDMG>>
                    <<set $dmgDealt.Combat to $baseDMG>>
                    <<set $dmgDealt.Total += $baseDMG>>
                    <<run $combat_log.push($gamename + ' punches ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                <<else>>
                    <<set $baseDMG to (($BluntSTR + $weaponBluntDMG - ($STRPercentDebuff*($BluntSTR + $weaponBluntDMG)/100) + ($STRPercentBuff*($BluntSTR + $weaponBluntDMG)/100)) * $critDMG) * $mobs[_i].BluntDEF>>
                    <<set $mobs[_i].CurHP -= $baseDMG>>
                    <<set $dmgDealt.Combat to $baseDMG>>                            
                    <<set $dmgDealt.Total += $baseDMG>>
                    <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' punches ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                <</if>>
            <</if>>
            <</for>>
        <<HitRelatedStatusPlayer>>
    <<elseif $curStamina <= 4>>
        <<set $attack to "Nothing">>
        <<set $curStamina += 5 + $INT>>
        <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
    <</if>>
<</if>>
/* Heavy Punch */
<<if $attack === "Heavy punch">>
    <<if $curStamina >= 12>>  
        <<set $curStamina -= 12>>
        <<set $curHunger -= 4>>
        <<set $curFatigue += 1>>
            <<for _i = 0; _i lte 99; _i++>>
                <<if $enemyHitPlayer === _i>>
                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                    <<if $critChance <= _critChanceRNG>>
                        <<set $baseDMG to ($weaponBluntDMG + $DEX/2 - ($DEXPercentDebuff*($DEX/2)/100) + ($DEXPercentBuff*($DEX/2)/100) + $BluntSTR - ($STRPercentDebuff*($BluntSTR + $weaponDMG)/100) + ($STRPercentBuff*( $BluntSTR + $weaponDMG)/100)) * $mobs[_i].BluntDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
                        <<run $combat_log.push($gamename + ' throws a heavy punch at ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                    <<else>>
                        <<set $baseDMG to (($weaponBluntDMG + $DEX/2 - ($DEXPercentDebuff*($DEX/2)/100) + ($DEXPercentBuff*($DEX/2)/100) + $BluntSTR - ($STRPercentDebuff*($BluntSTR + $weaponDMG)/100) + ($STRPercentBuff*( $BluntSTR + $weaponDMG)/100)) * $critDMG) * $mobs[_i].BluntDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
                        <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' throws a heavy punch at ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                    <</if>>
                <</if>>
            <</for>>
            <<HitRelatedStatusPlayer>>
    <<elseif $curStamina <= 11>>
        <<set $attack to "Nothing">>
        <<set $curStamina += 5 + $INT>>
        <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
    <</if>>
<</if>>
/* Stab */
<<if $attack === "Stab">>
    <<if $weaponType === "Short sword" or $weaponType === "Shield and sword">>
        <<if $curStamina >= 9>>  
            <<set $curStamina -= 9>>
            <<set $curHunger -= 1>>
            <<set $curFatigue += 3>>
            <<for _i = 0; _i lte 99; _i++>>
                <<if $enemyHitPlayer === _i>>
                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                    <<if $critChance <= _critChanceRNG>>
                        <<set $baseDMG to (($PierceSTR + $weaponPierceDMG - ($STRPercentDebuff*($PierceSTR + $weaponPierceDMG)/100) + ($STRPercentBuff*($PierceSTR + $weaponPierceDMG)/100)) * 0.8) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedCountCur += $bleedCountDealt/1.5>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt/2 * $mobs[_i].bleedDef>>
                        <<run $combat_log.push($gamename + ' stabs ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                    <<else>>
                        <<set $baseDMG to ((($PierceSTR + $weaponPierceDMG - ($STRPercentDebuff*($PierceSTR + $weaponPierceDMG)/100) + ($STRPercentBuff*($PierceSTR + $weaponPierceDMG)/100)) * 0.8) * $critDMG) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						            <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
						            <<set $mobs[_i].bleedPotency += $bleedPotencyDealt * $mobs[_i].bleedDef>>
                        <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' stabs ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                    <</if>>
                <</if>>
            <</for>>
            <<HitRelatedStatusPlayer>>
        <<elseif $curStamina <= 8>>
            <<set $attack to "Nothing">>
            <<set $attackText to "Do nothing">>
            <<set $curStamina += 5 + $INT>>
            <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
        <</if>>
    <<elseif $weaponType === "Rapier">>
        <<if $curStamina >= 6>>  
            <<set $attackText to "Stab">>
            <<set $curStamina -= 6>>
            <<set $curHunger -= 1>>
            <<set $curFatigue += 2>>
            <<for _i = 0; _i lte 99; _i++>>
                <<if $enemyHitPlayer === _i>>
                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                    <<if $critChance <= _critChanceRNG>>
                        <<set $baseDMG to ($PierceSTR + $weaponPierceDMG - ($STRPercentDebuff*($PierceSTR + $weaponPierceDMG)/100) + ($STRPercentBuff*($PierceSTR + $weaponPierceDMG)/100)) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedCountCur += $bleedCountDealt/1.5>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt/2 * $mobs[_i].bleedDef>>
                        <<run $combat_log.push($gamename + ' stabs ' + $mobs[_i].name + ' dealing ' + $baseDMG + ' damage')>>
                    <<else>>
                        <<set $baseDMG to (($PierceSTR + $weaponPierceDMG - ($STRPercentDebuff*($PierceSTR + $weaponPierceDMG)/100) + ($STRPercentBuff*($PierceSTR + $weaponPierceDMG)/100)) * $critDMG) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt * $mobs[_i].bleedDef>>
                        <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' stabs ' + $mobs[_i].name + ' dealing ' + $baseDMG + ' damage')>>
                    <</if>>
                <</if>>
            <</for>>
            <<HitRelatedStatusPlayer>>
        <<elseif $curStamina <= 5>>
            <<set $attack to "Nothing">>
            <<set $attackText to "Do nothing">>
            <<set $curStamina += 5 + $INT>>
            <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
        <</if>>
	<<elseif $weaponType === "Dagger">>
        <<if $curStamina >= 5>>  
            <<set $attackText to "Stab">>
            <<set $curStamina -= 5>>
            <<set $curHunger -= 1>>
            <<set $curFatigue += 2>>
            <<for _i = 0; _i lte 99; _i++>>
                <<if $enemyHitPlayer === _i>>
                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                    <<if $critChance <= _critChanceRNG>>
                        <<set $baseDMG to (($PierceSTR + $weaponPierceDMG - ($STRPercentDebuff*($PierceSTR + $weaponPierceDMG)/100) + ($STRPercentBuff*($PierceSTR + $weaponPierceDMG)/100)) * 0.75) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt * $mobs[_i].bleedDef>>
                        <<run $combat_log.push($gamename + ' stabs ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                    <<else>>
                        <<set $baseDMG to ((($PierceSTR + $weaponPierceDMG - ($STRPercentDebuff*($PierceSTR + $weaponPierceDMG)/100) + ($STRPercentBuff*($PierceSTR + $weaponPierceDMG)/100)) * 0.75) * $critDMG) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedCountCur += $bleedCountDealt*1.5>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt*1.5 * $mobs[_i].bleedDef>>
                        <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' stabs ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                    <</if>>
                <</if>>
            <</for>>
