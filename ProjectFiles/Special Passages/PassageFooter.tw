  <<elseif _statsNPC lte 100>>
    <<set $NPCs.Marcellus.SlashSTR += 1>>
    <<set $NPCs.Marcellus.CritChance += 0.1>>
  <</if>>
  <<set $NPCs.Marcellus.Level += 1>>
