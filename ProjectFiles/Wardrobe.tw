    <<goto "Wardrobe">>
  <<set $player.chestplate = "None">> 
  <<goto "Wardrobe">>
  <</link>> <</if>> + <<if $player.cape is "None">> Cape <<else>> <<link "$player.cape.name">> 
    /* Same code as personality select. I have no idea why or how it works but it does! */
