        <<HitRelatedStatusZegrath>>
        <<elseif $NPCs.Zegrath.CurSTM<= 14>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
            <<run $combat_log.push('Zegrath is too tired to fight so he does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackZegrath is "FireSword">>
        <<if $NPCs.Zegrath.CurSTM >= 40>>
            <<set $NPCs.Zegrath.CurSTM -= 40>>
            <<set $ZegrathFireSword += 10>>
            <<run $combat_log.push('Zegrath sets his swords on fire!')>>
        <<elseif $NPCs.Zegrath.CurSTM <= 39>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
        <</if>>
    <</if>>
    <<if $attackZegrath is "Unfocused strike">>
        <<if $NPCs.Zegrath.CurSTM >= 20>>
        <<set $NPCs.Zegrath.CurSTM -= 20>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitZegrath === _i>>
            <<if $NPCs.Zegrath.CritChance <= _critChanceRNGZegrath>>
                <<set $NPCs.Zegrath.baseDMG to (($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG) * $NPCs.Zegrath.STRPercentBuff) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
                <<run $combat_log.push('Zegrath swings his sword at ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                <<if $mobs[_i].StunnedCount >= 1>>
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
	        		<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
			        <<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('Zegrath does a follow up attack at the distracted ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                    <<set $mobs[_i].StunnedCount to 0>>
                    <<if $ZegrathFireSword >= 1>>
                        <<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt>>
    		    	    <<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt>>
                    <</if>>
                <</if>>
                <<if $mobs[_i].CurHP <= 0>>
                    <<set $NPCs.Zegrath.FlowCount += 3>>
                    <<set $NPCs.Zegrath.FlowPotency += 25>>
                    <<set $NPCs.Zegrath.turnChanceMax += 25>>
                    <<set $NPCs.Zegrath.turnChanceCur += 25>>
                <</if>>
                <<if $ZegrathFireSword >= 1>>
                    <<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt>>
				    <<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt>>
                <</if>>
                <<if $mobs[_i].StunnedCount <= 0>>
				    <<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
				    <<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<else>>
                    <<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
				    <<set $mobs[_i].bleedPotency += ($NPCs.Zegrath.bleedPotencyDealt*2) * $mobs[_i].bleedDef>>
                <</if>>
                <<set $CDUnfocusedStrikeZeg to 8>>
            <<else>>
                <<set $NPCs.Zegrath.baseDMG to ((($NPCs.Zegrath.SlashSTR + $NPCs.Zegrath.weaponSlashDMG) * $NPCs.Zegrath.STRPercentBuff) * $NPCs.Zegrath.CritDMG) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
                <<run $combat_log.push('Zegrath swings his sword at ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                <<if $mobs[_i].StunnedCount >= 1>>
                    <<set $NPCs.Zegrath.dmgDealtTotal += $NPCs.Zegrath.baseDMG>>
                    <<set $mobs[_i].CurHP -= $NPCs.Zegrath.baseDMG>>
	        		<<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
			        <<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt * $mobs[_i].bleedDef>>
                    <<run $combat_log.push('Zegrath does a follow up attack at the distracted ' + $mobs[_i].name + ' dealing ' + $NPCs.Zegrath.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                    <<set $mobs[_i].StunnedCount to 0>>
                    <<if $ZegrathFireSword >= 1>>
                        <<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt>>
    		    	    <<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt>>
                    <</if>>
                <</if>>
                <<if $mobs[_i].CurHP <= 0>>
                    <<set $NPCs.Zegrath.FlowCount += 3>>
                    <<set $NPCs.Zegrath.FlowPotency += 30>>
                    <<set $NPCs.Zegrath.turnChanceMax += 30>>
                    <<set $NPCs.Zegrath.turnChanceCur += 30>>
                <</if>>
                <<if $ZegrathFireSword >= 1>>
                    <<set $mobs[_i].burnCountCur += $NPCs.Zegrath.burnCountDealt>>
				    <<set $mobs[_i].burnPotency += $NPCs.Zegrath.burnPotencyDealt>>
                <</if>>
                <<if $mobs[_i].StunnedCount <= 0>>
				    <<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
				    <<set $mobs[_i].bleedPotency += $NPCs.Zegrath.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<else>>
                    <<set $mobs[_i].bleedCountCur += $NPCs.Zegrath.bleedCountDealt>>
				    <<set $mobs[_i].bleedPotency += ($NPCs.Zegrath.bleedPotencyDealt*2) * $mobs[_i].bleedDef>>
                <</if>>
                <<set $CDUnfocusedStrikeZeg to 8>>
                <<CritRelatedStatusesZegrath>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusZegrath>>
        <<elseif $NPCs.Zegrath.CurSTM<= 19>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
            <<run $combat_log.push('Zegrath is too tired to fight so he does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackZegrath is "FireSword">>
        <<if $NPCs.Zegrath.CurSTM >= 40>>
            <<set $NPCs.Zegrath.CurSTM -= 40>>
            <<set $ZegrathFireSword += 10>>
            <<run $combat_log.push('Zegrath sets his swords on fire!')>>
        <<elseif $NPCs.Zegrath.CurSTM <= 39>>
            <<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
        <</if>>
    <</if>>
<</if>>


/* Black wolf attacks */
<<if $partyMembers.includes($NPCs.BlackWolf.name)>>
	<<if $NPCs.BlackWolf.CurSTM >= 10 && $NPCs.BlackWolf.timeOut <= 0>>
    	<<set _randomHitBlackWolf to random(0, $mobs.length - 1)>>
      	<<set $NPCs.BlackWolf.baseDMG to ($NPCs.BlackWolf.SlashSTR) * $mobs[_randomHitBlackWolf].BluntDEF>>
    	<<set $mobs[_randomHitBlackWolf].CurHP -= $NPCs.BlackWolf.baseDMG>>
      	<<set $NPCs.BlackWolf.dmgDealtTotal += $NPCs.BlackWolf.baseDMG>>
      	<<set $NPCs.BlackWolf.CurSTM -= 10>>
		<<set $mobs[_i].bleedCountCur += $NPCs.BlackWolf.bleedCountDealt>>
		<<set $mobs[_i].bleedPotency += $NPCs.BlackWolf.bleedPotencyDealt * $mobs[_i].bleedDef>>
    	<<run $combat_log.push($NPCs.BlackWolf.name + ' slashes at the '+ $mobs[_randomHitBlackWolf].name + ' with her nails, dealing ' + $NPCs.BlackWolf.baseDMG.toFixed(2) + ' damage!')>>
    <<elseif $NPCs.BlackWolf.CurSTM >= 0 && $NPCs.BlackWolf.timeOut >= 1>>
    	<<set $NPCs.BlackWolf.CurSTM += $NPCs.BlackWolf.INT>>
      	<<set $NPCs.BlackWolf.timeOut -= 1>>
    <<elseif $NPCs.BlackWolf.timeOut <= 0 && $NPCs.BlackWolf.CurSTM <= 10>>
    	<<run $combat_log.push($NPCs.BlackWolf.name + ' needs to rest for a bit.')>>
		<<set $NPCs.BlackWolf.timeOut to kitsuneRNG(5, 12)>>
    	<<set $NPCs.BlackWolf.CurSTM += $NPCs.BlackWolf.INT>>
    <</if>>
<</if>>

<<burnPlayer>>
<<bleedTrigger>>
<<PowerUpCount>>
<<DefenseDownCountMobs>>
<<DefenseUpCountMobs>>
<<dazedPlayers>>
<<dazedPotencyPlayers>>
<<dazedPotencyMobs>>
<<FlowCountMobs>>

/* Player death */
<<if $CurHP lte 0>>
    <<goto "lose">>
<</if>>

/* Party death*/
<<if $NPCs.RadiantRose.CurHP lte 0 && $partyMembers.includes("RadiantRose")>>
    <<set $NPCs.RadiantRose.Affection to 0>>
    <<run $partyMembers.delete("RadiantRose")>>
    <<run $combat_log.push('RadiantRose escapes and leaves your party.')>>
    <<MemberEscape>>
    <<set $CurFear += (25 - ($FearPercentBuff*25/100) + ($FearPercentDebuff*25/100))>>
<</if>>
<<if $NPCs.ShadowScythe.CurHP lte 0 && $partyMembers.includes("ShadowScythe")>>
    <<set $NPCs.ShadowScythe.Affection to 0>>
    <<run $partyMembers.delete("ShadowScythe")>>
    <<run $combat_log.push('ShadowScythe escapes and leaves your party.')>>
    <<MemberEscape>>
    <<set $CurFear += (25 - ($FearPercentBuff*25/100) + ($FearPercentDebuff*25/100))>>
<</if>>
<<if $NPCs.CrimsonSentinel.CurHP lte 0 && $partyMembers.includes("CrimsonSentinel")>> 
    <<set $NPCs.CrimsonSentinel.Affection to 0>>
    <<run $partyMembers.delete("CrimsonSentinel")>>
    <<run $combat_log.push('CrimsonSentinel escapes and leaves your party.')>>
    <<MemberEscape>>
    <<set $CurFear += (25 - ($FearPercentBuff*25/100) + ($FearPercentDebuff*25/100))>>
<</if>>
<<if $NPCs.BlackWolf.CurHP lte 0 && $partyMembers.includes($NPCs.BlackWolf.name)>>
	<<set $NPCs.BlackWolf.Dead to true>> 
	<<run $partyMembers.delete($NPCs.BlackWolf.name)>>
    <<run $combat_log.push($NPCs.BlackWolf.name + ' died.')>>
    <<set $NPCs.Zegrath.Affection -= 100>>
    <<Deaths>>
    <<set $CurFear += (50 - ($FearPercentBuff*50/100) + ($FearPercentDebuff*50/100))>>
<</if>>
<<if $NPCs.Zegrath.CurHP lte 0 && $partyMembers.includes("Zegrath")>> 
    <<set $NPCs.Zegrath.Dead to true>>
    <<run $partyMembers.delete("Zegrath")>>
    <<run $combat_log.push('Zegrath died.')>>
    <<Deaths>>
    <<set $CurFear += (50 - ($FearPercentBuff*50/100) + ($FearPercentDebuff*50/100))>>
<</if>>

/* Ring effects */
<<for _i = 1; _i lte 10; _i++>>
    <<if State.variables["Finger" + _i] is "Ring of the living">>
      <<set $CurHP += $dmgDealt.Combat / 3>>
    <</if>>
<</for>>

/* Attack text */
<<set $attacktxt to random(100)>>

/* Mobs dying */
<<set _mob = $mobs>>
<<for _i = 0; _i lt $mobs.length; _i++>>
  <<if _mob[_i].CurHP <= 0.01>>
    <<MobRewards>>
    <<run $combat_log.push('Level ' + $mobs[_i].lvl + ' ' + $mobs[_i].name + ' has been slain.')>>
  	<<run $mobs.deleteAt(_i)>>
  <</if>>
<</for>>

/* Bonus turn */
<<set $turnChanceCur -= 100>>
<<set _bonusTurnRNG to random(100)>>
<<if $turnChanceCur > _bonusTurnRNG>>
    <<set _bonusTurn to true>>
    <<set $bonusTurnPlayer to true>>
<<else>>
    <<set $turnChanceCur -= $turnChanceCur>>
    <<set $attack to "No skill">>
<</if>>

<<if $partyMembers.includes("RadiantRose")>>
    <<set $NPCs.RadiantRose.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.RadiantRose.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnRadiantRose to true>>
    <<else>>
        <<set $NPCs.RadiantRose.turnChanceCur -= $NPCs.RadiantRose.turnChanceCur>>
        <<set $attackRadiantRose to "No skill">>
    <</if>>
<</if>>

<<if $partyMembers.includes("ShadowScythe")>>
    <<set $NPCs.ShadowScythe.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.ShadowScythe.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnShadowScythe to true>>
    <<else>>
        <<set $NPCs.ShadowScythe.turnChanceCur -= $NPCs.ShadowScythe.turnChanceCur>>
        <<set $attackShadowScythe to "No skill">>
    <</if>>
<</if>>

<<if $partyMembers.includes("CrimsonSentinel")>>
    <<set $NPCs.CrimsonSentinel.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.CrimsonSentinel.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnCrimsonSentinel to true>>
    <<else>>
        <<set $NPCs.CrimsonSentinel.turnChanceCur -= $NPCs.CrimsonSentinel.turnChanceCur>>
        <<set $attackCrimsonSentinel to "No skill">>
    <</if>>
<</if>>

<<if $partyMembers.includes("Zegrath")>>
    <<set $NPCs.Zegrath.turnChanceCur -= 100>>
    <<set _bonusTurnRNG to random(100)>>
    <<if $NPCs.Zegrath.turnChanceCur > _bonusTurnRNG>>
        <<set _bonusTurn to true>>
        <<set $bonusTurnZegrath to true>>
    <<else>>
        <<set $NPCs.Zegrath.turnChanceCur -= $NPCs.Zegrath.turnChanceCur>>
        <<set $attackZegrath to "No skill">>
    <</if>>
<</if>>

/* Bonus turn mob reset */

<<for _i = 0; _i lt $mobs.length; _i++>>
    <<set _mob[_i].turnChanceCur to _mob[_i].turnChanceMax>>
    <<set _mob[_i].bonusTurn to 0>>
<</for>>

<<stunnedMobs>>
<<stunnedPlayers>>

/* Mob selects player/party so it can also announce who is targetting who. Wont do rn. Too many issues. */

/*<<set _npc = $NPCs[_i]>> */
/*<<set _mob = $mobs>> */
/*<<for _i = 0; _i lt $mobs.length; _i++>> */
/*    <<set $randomHit to random(0, $partyMembers.length)>> */
/*    <<set $mobHit to kitsuneRNG(0, 100)>> */
/*    <<if $randomHit <= $partyMembers.length - 1>> */
/*        <<set _npc = $NPCs[$partyMembers[_randomHit]]>> */
/*        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' is targetting ' + _npc.name)>> */
/*    <<else>> */
/*        <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' is targetting ' + $gamename)>> */
/*    <</if>> */
/*<</for>> */

<<if _bonusTurn === true>>
	/* Bonus turn activate (obviously) */
    <<goto "Combat remake">>
<<elseif not $mobs.length && $floorBossBattle !== true>>
	/* Combat end here */
	<<goto "Combat win">>
<<elseif $mobs.length >= 1>>
    <<goto 'Enemy turn'>>
<</if>>

<</link>>
<<link "Run away">>

<<set _escape to kitsuneRNG(1, 100) + $DEX>>

<<set _mobsDEX to 0>>
<<set _mob = $mobs>>
<<for _i = 0; _i lt $mobs.length; _i++>>
    <<set _mobsDEX += $mobs[_i].DEX>>
<</for>>

<<if $curStamina >= 30>>
  <<if _escape >= _mobsDEX>>
    <<set $curStamina -= 30>>
    <<set $curFatigue += 25>>
    /* Turns getting fixed for player turn */
    <<set $turnChanceCur to $turnChanceMax>>
    <<set $NPCs.RadiantRose.turnChanceCur to $NPCs.RadiantRose.turnChanceMax>>
    <<set $NPCs.ShadowScythe.turnChanceCur to $NPCs.ShadowScythe.turnChanceMax>>
    <<set $NPCs.CrimsonSentinel.turnChanceCur to $NPCs.CrimsonSentinel.turnChanceMax>>
    <<set $NPCs.Zegrath.turnChanceCur to $NPCs.Zegrath.turnChanceMax>>
    <<unset $bonusTurnPlayer>>
    <<unset $bonusTurnRadiantRose>>
    <<unset $bonusTurnShadowScythe>>
    <<unset $bonusTurnCrimsonSentinel>>
    <<unset $bonusTurnZegrath>>
    <<set $mobs to []>>
    <<set $combat_log to []>>
    <<set $combat_drops = []>>
    <<set $combatCol to 0>>
    <<set $combatXP to 0>>

    <<set $NPCs.RadiantRose.bleedPotency to 0>>
	<<set $NPCs.RadiantRose.bleedCountCur to 0>>
	<<set $NPCs.ShadowScythe.bleedPotency to 0>>
	<<set $NPCs.ShadowScythe.bleedCountCur to 0>>
	<<set $NPCs.CrimsonSentinel.bleedPotency to 0>>
	<<set $NPCs.CrimsonSentinel.bleedCountCur to 0>>
	<<set $NPCs.Zegrath.bleedPotency to 0>>
	<<set $NPCs.Zegrath.bleedCountCur to 0>>

    <<set $critChance -= $PoisePotency>>
	<<set $PoisePotency to 0>>
    <<set $critDMG -= $PoiseCount/10>>
	<<set $PoiseCount to 0>>
    <<set $NPCs.RadiantRose.CritChance -= $NPCs.RadiantRose.PoisePotency>>
	<<set $NPCs.RadiantRose.PoisePotency to 0>>
    <<set $NPCs.RadiantRose.CritDMG -= $NPCs.RadiantRose.PoiseCount/10>>
	<<set $NPCs.RadiantRose.PoiseCount to 0>>
    <<set $NPCs.ShadowScythe.CritChance -= $NPCs.ShadowScythe.PoisePotency>>
	<<set $NPCs.ShadowScythe.PoisePotency to 0>>
    <<set $NPCs.ShadowScythe.CritDMG -= $NPCs.ShadowScythe.PoiseCount/10>>
	<<set $NPCs.ShadowScythe.PoiseCount to 0>>
    <<set $NPCs.CrimsonSentinel.CritChance -= $NPCs.CrimsonSentinel.PoisePotency>>
	<<set $NPCs.CrimsonSentinel.PoisePotency to 0>>
    <<set $NPCs.CrimsonSentinel.CritDMG -= $NPCs.CrimsonSentinel.PoiseCount/10>>
	<<set $NPCs.CrimsonSentinel.PoiseCount to 0>>
    <<set $NPCs.Zegrath.CritChance -= $NPCs.Zegrath.PoisePotency>>
	<<set $NPCs.Zegrath.PoisePotency to 0>>
    <<set $NPCs.Zegrath.CritDMG -= $NPCs.Zegrath.PoiseCount/10>>
	<<set $NPCs.Zegrath.PoiseCount to 0>>

    <<set $DEFPercentBuff -= $DefenseUpPotency>>
    <<set $DefenseUpCount -= $DefenseUpCount>>
    <<set $DefenseUpPotency -= $DefenseUpPotency>>
    <<set $NPCs.RadiantRose.DEFPercentBuff -= $NPCs.RadiantRose.DefenseUpPotency>>
    <<set $NPCs.RadiantRose.DefenseUpCount -= $NPCs.RadiantRose.DefenseUpCount>>
    <<set $NPCs.RadiantRose.DefenseUpPotency -= $NPCs.RadiantRose.DefenseUpPotency>>
    <<set $NPCs.ShadowScythe.DEFPercentBuff -= $NPCs.ShadowScythe.DefenseUpPotency>>
    <<set $NPCs.ShadowScythe.DefenseUpCount -= $NPCs.ShadowScythe.DefenseUpCount>>
    <<set $NPCs.ShadowScythe.DefenseUpPotency -= $NPCs.ShadowScythe.DefenseUpPotency>>
    <<set $NPCs.CrimsonSentinel.DEFPercentBuff -= $NPCs.CrimsonSentinel.DefenseUpPotency>>
    <<set $NPCs.CrimsonSentinel.DefenseUpCount -= $NPCs.CrimsonSentinel.DefenseUpCount>>
    <<set $NPCs.CrimsonSentinel.DefenseUpPotency -= $NPCs.CrimsonSentinel.DefenseUpPotency>>
    <<set $NPCs.Zegrath.DEFPercentBuff -= $NPCs.Zegrath.DefenseUpPotency>>
    <<set $NPCs.Zegrath.DefenseUpPotency -= $NPCs.Zegrath.DefenseUpPotency>>
    <<set $NPCs.Zegrath.DefenseUpCount -= $NPCs.Zegrath.DefenseUpCount>>

    <<set $DEFPercentBuff += $DefenseDownPotency>>
    <<set $DefenseDownCount -= $DefenseDownCount>>
    <<set $DefenseDownPotency -= $DefenseDownPotency>>
    <<set $NPCs.RadiantRose.DEFPercentBuff += $NPCs.RadiantRose.DefenseDownPotency>>
    <<set $NPCs.RadiantRose.DefenseDownCount -= $NPCs.RadiantRose.DefenseDownCount>>
    <<set $NPCs.RadiantRose.DefenseDownPotency -= $NPCs.RadiantRose.DefenseDownPotency>>
    <<set $NPCs.ShadowScythe.DEFPercentBuff += $NPCs.ShadowScythe.DefenseDownPotency>>
    <<set $NPCs.ShadowScythe.DefenseDownCount -= $NPCs.ShadowScythe.DefenseDownCount>>
    <<set $NPCs.ShadowScythe.DefenseDownPotency -= $NPCs.ShadowScythe.DefenseDownPotency>>
    <<set $NPCs.CrimsonSentinel.DEFPercentBuff += $NPCs.CrimsonSentinel.DefenseDownPotency>>
    <<set $NPCs.CrimsonSentinel.DefenseDownCount -= $NPCs.CrimsonSentinel.DefenseDownCount>>
    <<set $NPCs.CrimsonSentinel.DefenseDownPotency -= $NPCs.CrimsonSentinel.DefenseDownPotency>>
    <<set $NPCs.Zegrath.DEFPercentBuff += $NPCs.Zegrath.DefenseDownPotency>>
    <<set $NPCs.Zegrath.DefenseDownPotency -= $NPCs.Zegrath.DefenseDownPotency>>
    <<set $NPCs.Zegrath.DefenseDownCount -= $NPCs.Zegrath.DefenseDownCount>>

    <<set $DazedCount -= $DazedCount>>
    <<set $DazedPotency -= $DazedPotency>>
    <<set $StunnedCount -= $StunnedCount>>
    <<set $NPCs.RadiantRose.DazedCount -= $NPCs.RadiantRose.DazedCount>>
    <<set $NPCs.RadiantRose.DazedPotency -= $NPCs.RadiantRose.DazedPotency>>
    <<set $NPCs.RadiantRose.StunnedCount -= $NPCs.RadiantRose.StunnedCount>>
    <<set $NPCs.ShadowScythe.DazedCount -= $NPCs.ShadowScythe.DazedCount>>
    <<set $NPCs.ShadowScythe.DazedPotency -= $NPCs.ShadowScythe.DazedPotency>>
    <<set $NPCs.ShadowScythe.StunnedCount -= $NPCs.ShadowScythe.StunnedCount>>
    <<set $NPCs.CrimsonSentinel.DazedCount -= $NPCs.CrimsonSentinel.DazedCount>>
    <<set $NPCs.CrimsonSentinel.DazedPotency -= $NPCs.CrimsonSentinel.DazedPotency>>
    <<set $NPCs.CrimsonSentinel.StunnedCount -= $NPCs.CrimsonSentinel.StunnedCount>>
    <<set $NPCs.Zegrath.DazedCount -= $NPCs.Zegrath.DazedCount>>
    <<set $NPCs.Zegrath.DazedPotency -= $NPCs.Zegrath.DazedPotency>>
    <<set $NPCs.Zegrath.StunnedCount -= $NPCs.Zegrath.StunnedCount>>

    <<set $FlowCount -= $FlowCount>>
    <<set $turnChanceMax -= $FlowPotency>>
    <<set $FlowPotency -= $FlowPotency>>
    <<set $NPCs.RadiantRose.FlowCount -= $NPCs.RadiantRose.FlowCount>>
    <<set $NPCs.RadiantRose.turnChanceMax -= $NPCs.RadiantRose.FlowPotency>>
    <<set $NPCs.RadiantRose.FlowPotency -= $NPCs.RadiantRose.FlowPotency>>
    <<set $NPCs.ShadowScythe.FlowCount -= $NPCs.ShadowScythe.FlowCount>>
    <<set $NPCs.ShadowScythe.turnChanceMax -= $NPCs.ShadowScythe.FlowPotency>>
    <<set $NPCs.ShadowScythe.FlowPotency -= $NPCs.ShadowScythe.FlowPotency>>
    <<set $NPCs.CrimsonSentinel.FlowCount -= $NPCs.CrimsonSentinel.FlowCount>>
    <<set $NPCs.CrimsonSentinel.turnChanceMax -= $NPCs.CrimsonSentinel.FlowPotency>>
    <<set $NPCs.CrimsonSentinel.FlowPotency -= $NPCs.CrimsonSentinel.FlowPotency>>
    <<set $NPCs.Zegrath.FlowCount -= $NPCs.Zegrath.FlowCount>>
    <<set $NPCs.Zegrath.turnChanceMax -= $NPCs.Zegrath.FlowPotency>>
    <<set $NPCs.Zegrath.FlowPotency -= $NPCs.Zegrath.FlowPotency>>

    <<set $poisonCountCur to 0>>
    <<set $poisonPotency to 0>>
    <<set $NPCs.RadiantRose.poisonCountCur to 0>>
	<<set $NPCs.RadiantRose.poisonPotency to 0>>
	<<set $NPCs.ShadowScythe.poisonCountCur to 0>>
	<<set $NPCs.ShadowScythe.poisonPotency to 0>>
	<<set $NPCs.CrimsonSentinel.poisonCountCur to 0>>
	<<set $NPCs.CrimsonSentinel.poisonPotency to 0>>
	<<set $NPCs.Zegrath.poisonCountCur to 0>>
	<<set $NPCs.Zegrath.poisonPotency to 0>>

    <<if $CDThroatSlit>>
        <<unset $CDThroatSlit>>
    <</if>>
    <<if $CDLeapingSlash>>
        <<unset $CDLeapingSlash>>
    <</if>>
    <<if $CDMultistrike>>
        <<unset $CDMultistrike>>
    <</if>>
    <<if $CDMultistrikeRadiant>>
        <<unset $CDMultistrikeRadiant>>
    <</if>>
    <<if $CDBrace>>
        <<unset $CDBrace>>
    <</if>>
    <<if $CDBraceCrim>>
        <<unset $CDBraceCrim>>
    <</if>>
    <<if $CDPunctureSS>>
        <<unset $CDPunctureSS>>
    <</if>>
    <<if $CDUpperCut>>
        <<unset $CDUpperCut>>
    <</if>>
    <<if $CDConcussion>>
        <<unset $CDConcussion>>
    <</if>>
    <<if $CDUnfocusedStrike>>
        <<unset $CDUnfocusedStrike>>
    <</if>>
    <<if $CDUnfocusedStrikeZeg>>
        <<unset $CDUnfocusedStrikeZeg>>
    <</if>>

        /* Bonus turn mob reset */
        <<for _i = 0; _i lt $mobs.length; _i++>>
            <<set _mob[_i].turnChanceCur to _mob[_i].turnChanceMax>>
            <<set _mob[_i].bonusTurn to 0>>
        <</for>>
        <<goto "Run away...">>
	  <<else>>
		<<set $curStamina -= 15>>
    	<<set $curFatigue += 12>>
      <<run $combat_log.push('You tried escaping... You failed.')>>
    	<<goto "Enemy turn">>
	<</if>>
<</if>>
<</link>> ?stm 30