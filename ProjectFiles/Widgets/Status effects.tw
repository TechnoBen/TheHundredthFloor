<</widget>>

<<widget FlowCountMobs>>
<<for _i = 0; _i lt $mobs.length; _i++>>
	<<if _mob[_i].FlowCount >= 1>>
		<<set $mobs[_i].FlowCount -= 1>>
	<<elseif _mob[_i].FlowCount <= 0 && _mob[_i].FlowPotency >= 0.01>>
		<<set $mobs[_i].turnChanceMax -= $mobs[_i].FlowPotency>>
		<<set $mobs[_i].FlowPotency to 0>>
  	<</if>>
<</for>>
<</widget>>

<<widget FlowCountPlayers>>

	/* Player */
	<<if $FlowCount >= 1>>
    	<<set $FlowCount -= 1>>
	<<elseif $FlowCount <= 0 && $FlowPotency >= 0.01>>
		<<set $turnChanceMax -= $FlowPotency>>
		<<set $FlowPotency to 0>>
	<</if>>

	/* RadiantRose */
	<<if $NPCs.RadiantRose.FlowCount >= 1>>
		<<set $NPCs.RadiantRose.FlowCount -= 1>>
	<<elseif $NPCs.RadiantRose.FlowCount <= 0 && $NPCs.RadiantRose.FlowPotency >= 0.01>>
		<<set $NPCs.RadiantRose.turnChanceMax -= $NPCs.RadiantRose.FlowPotency>>
		<<set $NPCs.RadiantRose.FlowPotency to 0>>
	<</if>>

	/* ShadowScythe */
	<<if $NPCs.ShadowScythe.FlowCount >= 1>>
		<<set $NPCs.ShadowScythe.FlowCount -= 1>>
	<<elseif $NPCs.ShadowScythe.FlowCount <= 0 && $NPCs.ShadowScythe.FlowPotency >= 0.01>>
		<<set $NPCs.ShadowScythe.turnChanceMax -= $NPCs.ShadowScythe.FlowPotency>>
		<<set $NPCs.ShadowScythe.FlowPotency to 0>>
	<</if>>

	/* CrimsonSentinel */
	<<if $NPCs.CrimsonSentinel.FlowCount >= 1>>
		<<set $NPCs.CrimsonSentinel.FlowCount -= 1>>
	<<elseif $NPCs.CrimsonSentinel.FlowCount <= 0 && $NPCs.CrimsonSentinel.FlowPotency >= 0.01>>
		<<set $NPCs.CrimsonSentinel.turnChanceMax -= $NPCs.CrimsonSentinel.FlowPotency>>
		<<set $NPCs.CrimsonSentinel.FlowPotency to 0>>
	<</if>>

	/* Zegrath */
	<<if $NPCs.Zegrath.FlowCount >= 1>>
		<<set $NPCs.Zegrath.FlowCount -= 1>>
	<<elseif $NPCs.Zegrath.FlowCount <= 0 && $NPCs.Zegrath.FlowPotency >= 0.01>>
		<<set $NPCs.Zegrath.turnChanceMax -= $NPCs.Zegrath.FlowPotency>>
		<<set $NPCs.Zegrath.FlowPotency to 0>>
	<</if>>

<</widget>>

<<widget HitRelatedStatusMobs>>

	/* In short, whenever a skill is meant to trigger during a hit (or crit) it activates. */

	<<if _mob[_i].PowerUpPotency >= 0.01>>
		<<set $mobs[_i].STRPercentBuff -= $mobs[_i].PowerUpPotency>>
		<<set $mobs[_i].PowerUpPotency /= 2>>
		<<set $mobs[_i].STRPercentBuff += $mobs[_i].PowerUpPotency>>
	<</if>>

	/* Poison. */

	<<if _mob[_i].poisonCountCur >= 0.01>>
		<<set $mobs[_i].CurHP -= $mobs[_i].poisonPotency>>
		<<run $combat_log.push('<span class="poison">Level ' + $mobs[_i].lvl + ' ' + $mobs[_i].name + ' took ' + $mobs[_i].poisonPotency.toFixed(2) + '<img class="status" src = "Textures/Statuses/Poison.png" />damage</span>')>>
		<<set $mobs[_i].poisonCountCur -= 1>>
		<<set $mobs[_i].poisonPotency -= 1>>
	<</if>>

<</widget>>

<<widget HitRelatedStatusPlayer>>

	/* In short, whenever a skill is meant to trigger during a hit (or crit) it activates. */

	<<if $PowerUpPotency >= 0.01>>
		<<set $STRPercentBuff -= $PowerUpPotency>>
		<<set $PowerUpPotency /= 2>>
		<<set $STRPercentBuff += $PowerUpPotency>>
	<</if>>

	<<if $poisonCountCur >= 0.01>>
		<<set $CurHP -= $poisonPotency>>
		<<run $combat_log.push('<span class="poison">' + $gamename + ' took ' + $poisonPotency.toFixed(2) + '<img class="status" src = "Textures/Statuses/Poison.png" />damage</span>')>>
		<<set $poisonCountCur -= 1>>
		<<set $poisonPotency -= 1>>
	<</if>>

