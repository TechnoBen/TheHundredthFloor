<<widget "F1Forest1">>
<<set _randomEncounterDungeon to random(100)>>
<<if _randomEncounterDungeon lte 15>>
    <<goto "Dungeon 1.5">>
<<elseif _randomEncounterDungeon lte 100>>
	<<set $lastVisitedPassage to "Dungeon1.4">>
	<<set $mobAmount to random(100)>>
    <<if $mobAmount lte 5 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
       	<<mob skeleton>>
		<<mob skeleton>>
   		<<mob skeleton>>
    	<<goto "Combat remake">>
   	<<elseif $mobAmount lte 30 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
        <<mob skeleton>>
    	<<mob skeleton>>
		<<goto "Combat remake">>
    <<elseif $mobAmount lte 100 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
       	<<mob skeleton>>
		<<goto "Combat remake">>
	<</if>>
<</if>>
<</widget>>

