:: Boss rush hair [no-fainting-or-hunger] {"position":"1000,775","size":"100,100"}
<<button "Make me bald | 120 coins">>
<<if $Coins >= 120>> 
<<set $hairColor to "Bald">>
<<set $Coins -= 120>>
<<goto "Boss rush hair">>
<<elseif $Coins <= 119>>
<<script>>
UI.alert("You dont have enough coins!");
<</script>>
<</if>>
<</button>>

