                <<set $NPCs.ShadowScythe.CurSTM -= 31>>
                <<ShadowHiting>>
            <<else>>
                <<set $NPCs.ShadowScythe.baseDMG to ((($NPCs.ShadowScythe.weaponSlashDMG + $NPCs.ShadowScythe.DEX/2 + $NPCs.ShadowScythe.SlashSTR) * $NPCs.ShadowScythe.CritDMG) * $NPCs.ShadowScythe.STRPercentBuff) * $mobs[_i].SlashDEF>>
                <<set $NPCs.ShadowScythe.dmgDealtTotal += $NPCs.ShadowScythe.baseDMG>>
