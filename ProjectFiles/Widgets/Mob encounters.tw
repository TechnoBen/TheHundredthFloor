:: Mob encounters [widget] {"position":"2625,725","size":"100,100"}

<<widget "Plains1">>
	<<set $mobAmount to random(100)>>
    <<set $mobAttack to random(100)>>
<<if $mobAttack lte 25>>
    <<if $mobAmount lte 5 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
    	<<mob boar1>>
        <<mob boar1>>
        <<mob boar1>>
        <<mob boar1>>
        <<goto "Combat remake">>
    <<elseif $mobAmount lte 15 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
        <<mob boar1>>
        <<mob boar1>>
        <<mob boar1>>
        <<goto "Combat remake">>
    <<elseif $mobAmount lte 30 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
        <<mob boar1>>
        <<mob boar1>>
        <<goto "Combat remake">>
    <<elseif $mobAmount lte 100 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
        <<mob boar1>>
        <<goto "Combat remake">>
    <</if>>
<</if>>
<</widget>>

