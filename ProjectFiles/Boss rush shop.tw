:: Boss rush shop [no-fainting-or-hunger] {"position":"850,875","size":"100,100"}
<<nobr>><h2>Potions:</h2><</nobr>>
<<button "Buy health potion | 48 coins">>
<<if $Coins >= 48>> 
<<set $hpPOT += 1>>
<<goto "Boss rush shop">>
<<set $Coins -= 48>>
<<elseif $Coins <= 47>>
<<script>>
UI.alert("You dont have enough coins!");
<</script>>
<</if>>
<</button>>
