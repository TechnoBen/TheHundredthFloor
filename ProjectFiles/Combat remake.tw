                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                    <<if $critChance <= _critChanceRNG>>
                        <<set $baseDMG to ($SlashSTR + $weaponSlashDMG - ($STRPercentDebuff*($SlashSTR + $weaponSlashDMG)/100) + ($STRPercentBuff*($SlashSTR + $weaponSlashDMG)/100) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff))>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
                        <<if $mobs[_i].StunnedCount <= 0>>
						    <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
    						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt * $mobs[_i].bleedDef>>
                        <<else>>
                            <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
    						<<set $mobs[_i].bleedPotency += ($bleedPotencyDealt * 2) * $mobs[_i].bleedDef>>
                        <</if>>
                        <<run $combat_log.push($gamename + ' swings their sword at ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                        <<set $mobs[_i].poisonCountCur += $poisonCountDealt>>
                        <<set $mobs[_i].poisonPotency += $poisonPotencyDealt>>
                        <<set $mobs[_i].burnCountCur += $burnCountDealt>>
                        <<set $mobs[_i].burnPotency += $burnPotencyDealt>>
                        <<set $CDUnfocusedStrike to 8>>
                        <<if $mobs[_i].StunnedCount >= 1>>
                            <<set $mobs[_i].CurHP -= $baseDMG>>
                            <<set $dmgDealt.Combat to $baseDMG>>
                            <<set $dmgDealt.Total += $baseDMG>>
                            <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
    					    <<set $mobs[_i].bleedPotency += $bleedPotencyDealt * $mobs[_i].bleedDef>>
                            <<set $mobs[_i].poisonCountCur += $poisonCountDealt>>
                            <<set $mobs[_i].poisonPotency += $poisonPotencyDealt>>
                            <<set $mobs[_i].burnCountCur += $burnCountDealt>>
                            <<set $mobs[_i].burnPotency += $burnPotencyDealt>>
                            <<run $combat_log.push($gamename + ' does a follow up attack at the distracted ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                            <<set $mobs[_i].StunnedCount to 0>>
                            <<PlayerHit>>
                        <</if>>
                        <<if $mobs[_i].CurHP <= 0>>
                            <<set $FlowCount += 3>>
                            <<set $FlowPotency += 25>>
                            <<set $turnChanceMax += 25>>
                            <<set $turnChanceCur += 25>>
                        <</if>>
                    <<else>>
                        <<set $baseDMG to (($SlashSTR + $weaponSlashDMG - ($STRPercentDebuff*($SlashSTR + $weaponSlashDMG)/100) + ($STRPercentBuff*($SlashSTR + $weaponSlashDMG)/100) * $critDMG) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff))>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
                        <<set $mobs[_i].poisonCountCur += $poisonCountDealt>>
                        <<set $mobs[_i].poisonPotency += $poisonPotencyDealt * $critDMG>>
                        <<set $mobs[_i].burnCountCur += $burnCountDealt>>
                        <<set $mobs[_i].burnPotency += $burnPotencyDealt * $critDMG>>
						<<if $mobs[_i].StunnedCount <= 0>>
						    <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
    						<<set $mobs[_i].bleedPotency += ($bleedPotencyDealt * 1.5) * $mobs[_i].bleedDef>>
                        <<else>>
                            <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
    						<<set $mobs[_i].bleedPotency += ($bleedPotencyDealt * 2.5) * $mobs[_i].bleedDef>>
                        <</if>>
                        <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' swings their sword at ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                        <<set $CDUnfocusedStrike to 8>>
                        <<PlayerCrit>>
                        <<CritRelatedStatusesPlayer>>
                        <<if $mobs[_i].StunnedCount >= 1>>
                            <<set $mobs[_i].CurHP -= $baseDMG>>
                            <<set $dmgDealt.Combat to $baseDMG>>
                            <<set $dmgDealt.Total += $baseDMG>>
                            <<set $mobs[_i].poisonCountCur += $poisonCountDealt>>
                            <<set $mobs[_i].poisonPotency += $poisonPotencyDealt * $critDMG>>
                            <<set $mobs[_i].burnCountCur += $burnCountDealt>>
                            <<set $mobs[_i].burnPotency += $burnPotencyDealt * $critDMG>>
                            <<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
    					    <<set $mobs[_i].bleedPotency += ($bleedPotencyDealt * 1.5) * $mobs[_i].bleedDef>>
                            <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' does a follow up attack at the distracted ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                            <<set $mobs[_i].StunnedCount to 0>>
                        <</if>>
                        <<if $mobs[_i].CurHP <= 0>>
                            <<set $FlowCount += 3>>
                            <<set $FlowPotency += 30>>
                            <<set $turnChanceMax += 30>>
                            <<set $turnChanceCur += 30>>
                        <</if>>
                    <</if>>
                <</if>>
            <</for>>
            <<HitRelatedStatusPlayer>>
        <<elseif $curStamina <= 10>>
            <<set $attack to "Nothing">>
            <<set $attackText to "Do nothing">>
            <<set $curStamina += 5 + $INT>>
            <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
        <</if>>
    <</if>>
<</if>>

/* Party combat */
/* RadiantRose */
<<if $partyMembers.includes("RadiantRose")>>
    <<if $attackRadiantRose is "Do nothing">>
    <<run $combat_log.push('RadiantRose does nothing.')>>
        <<if $NPCs.RadiantRose.CurSTM <= $NPCs.RadiantRose.MaxSTM>>
            <<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
        <<elseif $NPCs.RadiantRose.CurSTM >= $NPCs.RadiantRose.MaxSTM>>
            <<set $NPCs.RadiantRose.CurSTM -= 5 + $NPCs.RadiantRose.INT>>
        <</if>>
    <</if>>
    <<set _critChanceRNGRadiant to kitsuneRNG(0, 100)>>
    <<if $attackRadiantRose is "Stab">>
        <<if $NPCs.RadiantRose.CurSTM >= 6>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitRadiantRose === _i>>
            <<if $NPCs.RadiantRose.CritChance <= _critChanceRNGRadiant>>
                <<set $NPCs.RadiantRose.baseDMG to (($NPCs.RadiantRose.PierceSTR + $NPCs.RadiantRose.weaponPierceDMG) * $NPCs.RadiantRose.STRPercentBuff) * ($mobs[_i].PierceDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt/1.5>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt/2 * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.RadiantRose.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.RadiantRose.poisonPotencyDealt>>
                <<set $mobs[_i].burnCountCur += $NPCs.RadiantRose.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.RadiantRose.burnPotencyDealt>>
                <<run $combat_log.push('RadiantRose stabs ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                <<RadiantHiting>>
                <<set $NPCs.RadiantRose.CurSTM -= 6>>
            <<else>>
                <<set $NPCs.RadiantRose.baseDMG to ((($NPCs.RadiantRose.PierceSTR + $NPCs.RadiantRose.weaponPierceDMG) * $NPCs.RadiantRose.CritDMG) * $NPCs.RadiantRose.STRPercentBuff) * ($mobs[_i].PierceDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.RadiantRose.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.RadiantRose.poisonPotencyDealt * $NPCs.RadiantRose.CritDMG>>
                <<set $mobs[_i].burnCountCur += $NPCs.RadiantRose.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.RadiantRose.burnPotencyDealt * $NPCs.RadiantRose.CritDMG>>
                <<run $combat_log.push('CRITICAL HIT! RadiantRose stabs ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                <<RadiantCritting>>
                <<set $NPCs.RadiantRose.CurSTM -= 6>>
                <<CritRelatedStatusesRadiant>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusRadiant>>
        <<elseif $NPCs.RadiantRose.CurSTM<= 5>>
            <<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
            <<run $combat_log.push('RadiantRose is too tired to fight so she does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackRadiantRose is "Charge">>
        <<if $NPCs.RadiantRose.CurSTM >= 10>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitRadiantRose === _i>>
            <<if $NPCs.RadiantRose.CritChance <= _critChanceRNGRadiant>>
                <<set $NPCs.RadiantRose.baseDMG to (($NPCs.RadiantRose.weaponPierceDMG + $NPCs.RadiantRose.DEX/2 + $NPCs.RadiantRose.PierceSTR) * $NPCs.RadiantRose.STRPercentBuff) * ($mobs[_i].PierceDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>> 
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.RadiantRose.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.RadiantRose.poisonPotencyDealt>>
                <<set $mobs[_i].burnCountCur += $NPCs.RadiantRose.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.RadiantRose.burnPotencyDealt>>
                <<run $combat_log.push('RadiantRose charges at ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                <<RadiantHiting>>
                <<set $NPCs.RadiantRose.CurSTM -= 10>>
            <<else>>
                <<set $NPCs.RadiantRose.baseDMG to ((($NPCs.RadiantRose.weaponPierceDMG + $NPCs.RadiantRose.DEX/2 + $NPCs.RadiantRose.PierceSTR) * $NPCs.RadiantRose.CritDMG) * $NPCs.RadiantRose.STRPercentBuff) * ($mobs[_i].PierceDEF * $mobs[_i].DEFPercentBuff)>> 
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt*1.5>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt*1.5 * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.RadiantRose.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.RadiantRose.poisonPotencyDealt * $NPCs.RadiantRose.CritDMG>>
                <<set $mobs[_i].burnCountCur += $NPCs.RadiantRose.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.RadiantRose.burnPotencyDealt * $NPCs.RadiantRose.CritDMG>>
                <<run $combat_log.push('CRITICAL HIT! RadiantRose charges at ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                <<RadiantCritting>>
                <<CritRelatedStatusesRadiant>>
                <<set $NPCs.RadiantRose.CurSTM -= 10>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusRadiant>>
        <<elseif $NPCs.RadiantRose.CurSTM<= 9>>
            <<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
            <<run $combat_log.push('RadiantRose is too tired to fight so she does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackRadiantRose is "Multi strike">>
        <<if $NPCs.RadiantRose.CurSTM >= 20>>
        <<set $NPCs.RadiantRose.CurSTM -= 20>>
        <<set $CDMultistrikeRadiant to 6>>
        <<set _attacksMultistrikeRad to Math.round(3 + ($NPCs.RadiantRose.DEX/10))>>
        <<for _i range _attacksMultistrikeRad>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitRadiantRose === _i>>
            <<if $NPCs.RadiantRose.CritChance <= _critChanceRNGRadiant>>
                <<set $NPCs.RadiantRose.baseDMG to (($NPCs.RadiantRose.weaponPierceDMG + $NPCs.RadiantRose.DEX/2 + $NPCs.RadiantRose.PierceSTR) * $NPCs.RadiantRose.STRPercentBuff) * ($mobs[_i].PierceDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>> 
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<set $NPCs.RadiantRose.PoiseCount += 1>>
                <<set $NPCs.RadiantRose.CritChance += 5>>
                <<set $NPCs.RadiantRose.PoisePotency += 5>>
                <<set $NPCs.RadiantRose.CritDMG += 0.1>>
                <<set $mobs[_i].poisonCountCur += $NPCs.RadiantRose.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.RadiantRose.poisonPotencyDealt>>
                <<set $mobs[_i].burnCountCur += $NPCs.RadiantRose.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.RadiantRose.burnPotencyDealt>>
                <<run $combat_log.push('RadiantRose charges at ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                <<RadiantHiting>>
            <<else>>
                <<set $NPCs.RadiantRose.baseDMG to ((($NPCs.RadiantRose.weaponPierceDMG + $NPCs.RadiantRose.DEX/2 + $NPCs.RadiantRose.PierceSTR) * $NPCs.RadiantRose.CritDMG) * $NPCs.RadiantRose.STRPercentBuff) * ($mobs[_i].PierceDEF * $mobs[_i].DEFPercentBuff)>> 
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt*1.5>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt*1.5 * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.RadiantRose.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.RadiantRose.poisonPotencyDealt * $NPCs.RadiantRose.CritDMG>>
                <<set $mobs[_i].burnCountCur += $NPCs.RadiantRose.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.RadiantRose.burnPotencyDealt * $NPCs.RadiantRose.CritDMG>>
                <<run $combat_log.push('CRITICAL HIT! RadiantRose charges at ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Pierce.png" />damage')>>
                <<RadiantCritting>>
                <<CritRelatedStatusesRadiant>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusRadiant>>
        <</for>>
        <<elseif $NPCs.RadiantRose.CurSTM<= 19>>
            <<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
            <<run $combat_log.push('RadiantRose is too tired to fight so she does nothing.')>>
        <</if>>
    <</if>>
<</if>>

/* ShadowScythe */
<<if $partyMembers.includes("ShadowScythe")>>
    <<if $attackShadowScythe is "Do nothing">>
    <<run $combat_log.push('ShadowScythe does nothing.')>>
        <<if $NPCs.ShadowScythe.CurSTM <= $NPCs.ShadowScythe.MaxSTM>>
            <<set $NPCs.ShadowScythe.CurSTM += 5 + $NPCs.ShadowScythe.INT>>
        <<elseif $NPCs.ShadowScythe.CurSTM >= $NPCs.ShadowScythe.MaxSTM>>
            <<set $NPCs.ShadowScythe.CurSTM -= 5 + $NPCs.ShadowScythe.INT>>
        <</if>>
    <</if>>
    <<set _critChanceRNGShadow to kitsuneRNG(0, 100)>>
    <<if $attackShadowScythe is "Slash">>
        <<if $NPCs.ShadowScythe.CurSTM >= 25>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitShadow === _i>>
            <<if $NPCs.ShadowScythe.CritChance <= _critChanceRNGShadow>>
                <<set $NPCs.ShadowScythe.baseDMG to (($NPCs.ShadowScythe.SlashSTR + $NPCs.ShadowScythe.weaponSlashDMG) * $NPCs.ShadowScythe.STRPercentBuff) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.ShadowScythe.dmgDealtTotal += $NPCs.ShadowScythe.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.ShadowScythe.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.ShadowScythe.bleedCountDealt>>
				<<set $mobs[_i].bleedPotency += $NPCs.ShadowScythe.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.ShadowScythe.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.ShadowScythe.poisonPotencyDealt>>
                <<set $mobs[_i].burnCountCur += $NPCs.ShadowScythe.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.ShadowScythe.burnPotencyDealt>>
                <<run $combat_log.push('ShadowScythe slashes at ' + $mobs[_i].name + ' with his scythe dealing ' + $NPCs.ShadowScythe.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                <<set $NPCs.ShadowScythe.CurSTM -= 25>>
                <<ShadowHiting>>
            <<else>>
                <<set $NPCs.ShadowScythe.baseDMG to ((($NPCs.ShadowScythe.SlashSTR + $NPCs.ShadowScythe.weaponSlashDMG) * $NPCs.ShadowScythe.CritDMG) * $NPCs.ShadowScythe.STRPercentBuff) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.ShadowScythe.dmgDealtTotal += $NPCs.ShadowScythe.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.ShadowScythe.baseDMG>> 
				<<set $mobs[_i].bleedCountCur += $NPCs.ShadowScythe.bleedCountDealt*1.5>>
				<<set $mobs[_i].bleedPotency += $NPCs.ShadowScythe.bleedPotencyDealt*1.5 * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.ShadowScythe.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.ShadowScythe.poisonPotencyDealt * $NPCs.ShadowScythe.CritDMG>>
                <<set $mobs[_i].burnCountCur += $NPCs.ShadowScythe.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.ShadowScythe.burnPotencyDealt * $NPCs.ShadowScythe.CritDMG>>
                <<run $combat_log.push('CRITICAL HIT! ShadowScythe slashes at ' + $mobs[_i].name + ' with his scythe dealing ' + $NPCs.ShadowScythe.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                <<set $NPCs.ShadowScythe.CurSTM -= 25>>
                <<ShadowCritting>>
                <<CritRelatedStatusesShadow>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusShadow>>
        <<elseif $NPCs.ShadowScythe.CurSTM <= 25>>
            <<set $NPCs.ShadowScythe.CurSTM += 5 + $NPCs.ShadowScythe.INT>>
            <<run $combat_log.push('ShadowScythe is too tired to fight so he does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackShadowScythe is "Charge & sweep">>
        <<if $NPCs.ShadowScythe.CurSTM >= 31>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitShadow === _i>>
            <<if $NPCs.ShadowScythe.CritChance <= _critChanceRNGShadow>>
                <<set $NPCs.ShadowScythe.baseDMG to (($NPCs.ShadowScythe.weaponSlashDMG + $NPCs.ShadowScythe.DEX/2 + $NPCs.ShadowScythe.SlashSTR) * $NPCs.ShadowScythe.STRPercentBuff) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.ShadowScythe.dmgDealtTotal += $NPCs.ShadowScythe.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.ShadowScythe.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.ShadowScythe.bleedCountDealt/1.1>>
				<<set $mobs[_i].bleedPotency += $NPCs.ShadowScythe.bleedPotencyDealt/1.2 * $mobs[_i].bleedDef>>
                <<set $mobs[_i].poisonCountCur += $NPCs.ShadowScythe.poisonCountDealt>>
                <<set $mobs[_i].poisonPotency += $NPCs.ShadowScythe.poisonPotencyDealt>>
                <<set $mobs[_i].burnCountCur += $NPCs.ShadowScythe.burnCountDealt>>
                <<set $mobs[_i].burnPotency += $NPCs.ShadowScythe.burnPotencyDealt>>
                <<run $combat_log.push('ShadowScythe charges at ' + $mobs[_i].name + ' and sweeps his scythe dealing ' + $NPCs.ShadowScythe.baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Slash.png" />damage')>>
                <<set $NPCs.ShadowScythe.CurSTM -= 31>>
                <<ShadowHiting>>
            <<else>>
                <<set $NPCs.ShadowScythe.baseDMG to ((($NPCs.ShadowScythe.weaponSlashDMG + $NPCs.ShadowScythe.DEX/2 + $NPCs.ShadowScythe.SlashSTR) * $NPCs.ShadowScythe.CritDMG) * $NPCs.ShadowScythe.STRPercentBuff) * ($mobs[_i].SlashDEF * $mobs[_i].DEFPercentBuff)>>
                <<set $NPCs.ShadowScythe.dmgDealtTotal += $NPCs.ShadowScythe.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.ShadowScythe.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.ShadowScythe.bleedCountDealt*1.4>>
				<<set $mobs[_i].bleedPotency += $NPCs.ShadowScythe.bleedPotencyDealt*1.3 * $mobs[_i].bleedDef>>
