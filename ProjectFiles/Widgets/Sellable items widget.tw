:: Sellable items widget [widget] {"position":"2000,725","size":"100,100"}
/*Make sure to put this shit in a <ol>*/

/*Mob loot*/
<<widget "SellMobLoot">>
<<if $boarLeather > 0>>
    <li>Sell boar leather for 7 coins (You have $boarLeather) <<link "Sell 1">>
        <<set $boarLeather -= 1>> 
        <<set $Coins += 7>>
        <<goto $lastVisitedPassage1>>
    <</link>> <<if $boarLeather >= 5>>| <<link "Sell 5">>    
        <<set $boarLeather -= 5>> 
        <<set $Coins += 35>> 
        <<goto $lastVisitedPassage1>>
    <</link>><</if>> <<if $boarLeather >= 10>>| <<link "Sell 10">> 
        <<set $boarLeather -= 10>>
        <<set $Coins += 70>>
        <<goto $lastVisitedPassage1>>
    <</link>><</if>></li>
<</if>>
