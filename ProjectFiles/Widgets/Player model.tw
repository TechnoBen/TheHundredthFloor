	<<elseif $isShirtOn is "Black open shoulder shirt">>
		<img class="shirt" src = "Textures/armor/StarterGear/FemBlackShirtOpenSholder.png" width="140%" />
        <<elseif $isShirtOn is "Blue shirt">>
