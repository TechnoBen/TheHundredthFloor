:: Order food [no-fainting-or-hunger no-party-time-loss] {"position":"1475,2050","size":"100,100"}
<<button "Buy one star cooked boar meat | 58 col">>
<<if $Coins >= 58>> 
<<set $oneStarBmeat += 1>>
<<notify>> You bought cooked boar meat! <</notify>>
<<set $Coins -= 58>>
<<dateadd '26m'>>
<<goto "Order food">>
<<elseif $Coins <= 57>>
<<script>>
UI.alert("You dont have enough col!");
<</script>>
<</if>>
<</button>>
