        <<set $NPCs.ShadowScythe.blockingModifier to 0.5>>
    <<else>>
        <<run $combat_log.push('ShadowScythe is too tired to block.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attackShadowScythe === "Dodge">>
    <<if $NPCs.ShadowScythe.CurSTM >= 15>>
        <<run $combat_log.push('ShadowScythe gets ready to dodge.')>>
        <<set $NPCs.ShadowScythe.CurSTM -= 15>>
        <<set $NPCs.ShadowScythe.evadeModifier to 75>>
    <<else>>
        <<run $combat_log.push('ShadowScythe is too tired to dodge.')>>
    <</if>>
<</if>>
<</if>>

/* CrimsonSentinel */
<<if $partyMembers.includes("CrimsonSentinel")>>
/* Doing nothing */

<<if $attackCrimsonSentinel === "Do nothing">>
<<run $combat_log.push('CrimsonSentinel does nothing.')>>
<</if>>
/* Blocking */
<<if $attackCrimsonSentinel === "Block">>
    <<if $NPCs.CrimsonSentinel.CurSTM >= 8>>
        <<run $combat_log.push('CrimsonSentinel gets into a blocking stance.')>>
        <<set $NPCs.CrimsonSentinel.CurSTM -= 8>>
        <<set $NPCs.CrimsonSentinel.blockingModifier to 0.5>>
    <<else>>
        <<run $combat_log.push('CrimsonSentinel is too tired to block.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attackCrimsonSentinel === "Dodge">>
    <<if $NPCs.CrimsonSentinel.CurSTM >= 15>>
        <<run $combat_log.push('CrimsonSentinel gets ready to dodge.')>>
        <<set $NPCs.CrimsonSentinel.CurSTM -= 15>>
        <<set $NPCs.CrimsonSentinel.evadeModifier to 75>>
    <<else>>
        <<run $combat_log.push('CrimsonSentinel is too tired to dodge.')>>
    <</if>>
<</if>>
<</if>>

/* Zegrath */

<<if $partyMembers.includes("Zegrath")>>
/* Doing nothing */
<<if $attackZegrath === "Do nothing">>
<<run $combat_log.push('Zegrath does nothing.')>>
<</if>>
/* Blocking */
<<if $attackZegrath === "Block">>
    <<if $NPCs.Zegrath.CurSTM >= 8>>
        <<run $combat_log.push('Zegrath gets into a blocking stance.')>>
        <<set $NPCs.Zegrath.CurSTM -= 8>>
        <<set $NPCs.Zegrath.blockingModifier to 0.5>>
    <<else>>
        <<run $combat_log.push('Zegrath doesnt feel like blocking.')>>
    <</if>>
