Weapon damage:
Slash: <<= $weaponSlashDMG.toFixed(2)>>
Pierce: <<= $weaponPierceDMG.toFixed(2)>>
Blunt: <<= $weaponBluntDMG.toFixed(2)>>
Armor defence:
Slash: <<= $armorSlashDEF.toFixed(2)>>
Pierce: <<= $armorPierceDEF.toFixed(2)>>
Blunt: <<= $armorBluntDEF.toFixed(2)>>

<<link [[Change your personality|Personality selection]]>> <<set $lastVisitedPassage5 to "Wardrobe">> <</link>>

<<nobr>>
<<link [[Starter Chestplate|Wardrobe]]>>
<<set $inventory.starterChestplate = clone(setup.armors.starterChestplate)>>
<</link>> | 
<<link [[Copper Sword|Wardrobe]]>>
<<set $inventory.copperSword = clone(setup.weapons.copperSword)>>
<</link>> | 
<<link [[Copper rapier|Wardrobe]]>>
<<set $inventory.copperRapier = clone(setup.weapons.copperRapier)>>
<</link>> | 
<<link [[Copper Sword|Wardrobe]]>>
<<set $inventory.copperSword = clone(setup.weapons.copperSword)>>
<</link>> | 
<<link [[Copper Mace|Wardrobe]]>>
<<set $inventory.copperMace = clone(setup.weapons.copperMace)>>
<</link>> | 
<<link [[Copper Dagger|Wardrobe]]>>
<<set $inventory.copperDagger = clone(setup.weapons.copperDagger)>>
<</link>> | 
<<link [[Copper heavy sword|Wardrobe]]>>
<<set $inventory.copperHeavySword = clone(setup.weapons.copperHeavySword)>>
<</link>> | 
<<link [[Starter Sword|Wardrobe]]>>
<<set $inventory.starterSword = clone(setup.weapons.starterSword)>>
<</link>> | 
<<link [[Starter shirt|Wardrobe]]>>
<<set $inventory.starterShirt = clone(setup.clothes.starterShirt)>>
<</link>> | 
<<link [[Open shoulder shirt|Wardrobe]]>>
<<set $inventory.openShoulderShirt = clone(setup.clothes.openShoulderShirt)>>
<</link>> | 
<<link [[Open shoulder shirt|Wardrobe]]>>
<<set $inventory.openShoulderShirt1 = clone(setup.clothes.openShoulderShirt1)>>
<</link>> | 
<<link [[White jeans|Wardrobe]]>>
<<set $inventory.whiteJeans = clone(setup.clothes.whiteJeans)>>
<</link>> | 
<<link [[Gray skirt|Wardrobe]]>>
<<set $inventory.graySkirt = clone(setup.clothes.graySkirt)>>
<</link>> | 
<<link [[Old boots|Wardrobe]]>>
<<set $inventory.oldBoots = clone(setup.clothes.oldBoots)>>
<</link>> | 
<<link [[Boar meat|Wardrobe]]>>
  <<if !$inventory.boarMeat >>
    <<set $inventory.boarMeat = clone(setup.items.boarMeat)>>
    <<set $inventory.boarMeat.count += 1>>
  <<else>>
    <<set $inventory.boarMeat.count += 1>>
  <</if>>
<</link>>| 
<</nobr>>

Front: 
<<link [[Bald|Wardrobe]]>>
<<set $player.hair.top = "">>
<<goto "Wardrobe">>
<</link>> | <<link [[Fluffy bangs|Wardrobe]]>>
<<set $player.hair.top = "Textures/Hair/Front/Fluffy bangs.png">>
<<goto "Wardrobe">>
<</link>> | <<link [[Spiky bangs|Wardrobe]]>>
<<set $player.hair.top = "Textures/Hair/Front/Spiky bangs.png">>
<<goto "Wardrobe">>
<</link>>
Top:
<<link [[Bald|Wardrobe]]>>
<<set $player.hair.front = "">>
<</link>> | <<link [[Fluffy bangs|Wardrobe]]>>
<<set $player.hair.front = "Textures/Hair/Top/Fluffy top.png">>
<<goto "Wardrobe">>
<</link>> | <<link [[Shaved top|Wardrobe]]>>
<<set $player.hair.front = "Textures/Hair/Top/Shaved top.png">>
<<goto "Wardrobe">>
<</link>> | <<link [[Spiky top|Wardrobe]]>>
<<set $player.hair.front = "Textures/Hair/Top/Spiky top.png">>
<<goto "Wardrobe">>
<</link>>
Back:
<<link [[Bald|Wardrobe]]>>
<<set $player.hair.back = "">>
<</link>> | <<link [[Fluffy bottom|Wardrobe]]>>
<<set $player.hair.back = "Textures/Hair/Bottom/Fluffy bottom.png">>
<<goto "Wardrobe">>
<</link>> | <<link [[Fluffy long bottom|Wardrobe]]>>
<<set $player.hair.back = "Textures/Hair/Bottom/Fluffy long bottom.png">>
<<goto "Wardrobe">>
<</link>> | <<link [[Fluffy medium bottom|Wardrobe]]>>
<<set $player.hair.back = "Textures/Hair/Bottom/Fluffy medium bottom.png">>
<<goto "Wardrobe">>
<</link>>

<<link [[Male or fem|Wardrobe]]>>
  <<if $gender is "Male">>
    <<set $gender to "Female">>
  <<else>>
    <<set $gender to "Male">>
  <</if>>
  <<goto "Wardrobe">>
<</link>>

<<link "Clear filters">> 
  <<set $invFilters to ["None"]>>
  <<goto "Wardrobe">>
<</link>>
<<link "set Filter to edible">> 
  <<set $invFilters to ["edible"]>>
  <<goto "Wardrobe">>
<</link>>
<<link "push Filter to edible">> 
  <<run $invFilters.push("edible")>>
  <<goto "Wardrobe">>
<</link>>
<<link "set Filter to weapon">> 
  <<set $invFilters to ["weapon"]>>
  <<goto "Wardrobe">>
<</link>>
<<link "push Filter to weapon">> 
  <<run $invFilters.push("weapon")>>
  <<goto "Wardrobe">>
<</link>>

<<nobr>>
<<set _isNone to $invFilters.includes("None")>>

<<for _i, _item range $inventory>>
    <<capture _i>>
        <<if _item.tags.includes($invFilters) or _isNone >>
            <<hovertip _item.description>><<= $inventory[_i].name>><</hovertip>>
            <<if _item.count>>(_item.count)<</if>> |

            <<if _item.tags.includes("weapon")>>

                <<if $player.rightHand is "None">>
                    <<link "Equip right hand">>
                        <<set $player.rightHand = clone($inventory[_i])>>
                        <<run delete $inventory[_i]>>
                        <<goto "Wardrobe">>
                    <</link>>
                <<else>>
                    Unaquipable
                <</if>>
                 | 
                <<if $player.leftHand is "None">>
                    <<link "Equip left hand">>
                        <<set $player.leftHand = clone($inventory[_i])>>
                        <<run delete $inventory[_i]>>
                        <<goto "Wardrobe">>
                    <</link>> |
                <<else>>
                    Unnaquipable |
                <</if>>

    		<</if>>
    		    <<if _item.tags.includes("armor")>>
                <<link "Equip armor">>
                    <<if $inventory[_i].tags.includes("helmet")>>
                        <<if $player.helmet !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.helmet = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <<elseif $inventory[_i].tags.includes("chestplate")>>
                        <<if $player.chestplate !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.chestplate = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <<elseif $inventory[_i].tags.includes("leggings")>>
                        <<if $player.leggings !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.leggings = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <<elseif $inventory[_i].tags.includes("boots")>>
                        <<if $player.boots !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.boots = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <</if>>
                <</link>>
                | 
            <</if>>
            <<if _item.tags.includes("clothes")>>
                <<link "Wear clothe">>
                    <<if $inventory[_i].tags.includes("shirt")>>
                          <<if $player.shirt !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.shirt = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <<elseif $inventory[_i].tags.includes("pants")>>
                        <<if $player.pants !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.pants = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <<elseif $inventory[_i].tags.includes("shoes")>>
                        <<if $player.boots !== "None">>
                            <<script>>
                              UI.alert("You have already equipped something in that slot!<br>Unequip it first.");
                            <</script>>
                        <<else>>
                            <<set $player.boots = clone($inventory[_i])>>
                            <<run delete $inventory[_i]>>
                            <<goto "Wardrobe">>
                        <</if>>
                    <</if>>
                <</link>>
                | 
            <</if>>
            <<link "Remove 1">>
                <<if $inventory[_i].count > 1>>
                    <<set $inventory[_i].count -= 1>>
                <<else>>
                    <<run delete $inventory[_i]>>
                <</if>>
                <<goto "Wardrobe">>
            <</link>>
            <<if $inventory[_i].count >= 5>>
                | <<link "Remove 5">>
                    <<set $inventory[_i].count -= 5>>
                    <<goto "Wardrobe">>
                <</link>>
            <</if>>
            <<if $inventory[_i].count >= 10>>
                | <<link "Remove 10">>
                    <<set $inventory[_i].count -= 10>>
                    <<goto "Wardrobe">>
                <</link>>
            <</if>>
            <<if $inventory[_i].count >= 2>>
                | <<link "Remove all">>
                    <<run delete $inventory[_i]>>
                    <<goto "Wardrobe">>
                <</link>>
            <</if>>
        <</if>>
    <br>
    <</capture>>
<</for>>
<</nobr>>