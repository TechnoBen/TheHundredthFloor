  <</if>>
  <<set $NPCs.ShadowScythe.Level += 1>>
  <<set $NPCs.ShadowScythe.CurXP -= $NPCs.ShadowScythe.MaxXP>>
  <<set $NPCs.ShadowScythe.MaxHP += 50>>
