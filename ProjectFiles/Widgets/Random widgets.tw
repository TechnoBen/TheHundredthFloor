:: Random widgets [widget] {"position":"2375,725","size":"100,100"}
<<widget "Party2FBossAttack">>
	<<if $partyMembers.includes("RadiantRose")>>\
    	<<set $mobs[0].CurHP -= $NPCs.RadiantRose.DEX/7 + $NPCs.RadiantRose.PierceSTR/5 + $NPCs.RadiantRose.PierceSTR>>
        <<set $MonsterDMGDealt += $NPCs.RadiantRose.DEX/7 + $NPCs.RadiantRose.PierceSTR/5 + $NPCs.RadiantRose.PierceSTR>>
	<</if>>
	<<if $partyMembers.includes("ShadowScythe")>>\
	    <<set $mobs[0].CurHP -= $NPCs.ShadowScythe.DEX/7 + $NPCs.ShadowScythe.SlashSTR/5 + $NPCs.ShadowScythe.SlashSTR>>
        <<set $MonsterDMGDealt += $NPCs.ShadowScythe.DEX/7 + $NPCs.ShadowScythe.SlashSTR/5 + $NPCs.ShadowScythe.SlashSTR>>
	<</if>>
	<<if $partyMembers.includes("CrimsonSentinel")>>\
	    <<set $mobs[0].CurHP -= $NPCs.CrimsonSentinel.SlashSTR/4 + $NPCs.CrimsonSentinel.weaponSlashDMG>>
        <<set $MonsterDMGDealt += $NPCs.CrimsonSentinel.SlashSTR + $NPCs.CrimsonSentinel.weaponSlashDMG>>
	<</if>>
	<<if $partyMembers.includes("Zegrath")>>\
	    <<set $mobs[0].CurHP -= $STRZegrath/5 + $weaponDMGZegrath>>
        <<set $MonsterDMGDealt += $STRZegrath/5 + $weaponDMGZegrath>>
	<</if>>
	<<if $partyMembers.includes("BlackWolf")>>\
	    <<set $mobs[0].CurHP -= $NPCs.BlackWolf.SlashSTR/3>>
        <<set $MonsterDMGDealt += $NPCs.BlackWolf.SlashSTR/3>>
	<</if>>
	<<set $mobs[0].CurHP -= $SlashSTR/5 + $weaponSlashDMG/5>>
	<<set $MonsterDMGDealt += $SlashSTR/5 + $weaponSlashDMG/5>>
<</widget>>

<<widget "Party2FBossHit">>
	<<if $partyMembers.includes("RadiantRose")>>
		<<set $NPCs.RadiantRose.CurHP -= $mobs[0].BluntSTR - ($NPCs.RadiantRose.BluntDEF + $NPCs.RadiantRose.armorBluntDEF)>>
	<</if>>
	<<if $partyMembers.includes("ShadowScythe")>>
	    <<set $NPCs.ShadowScythe.CurHP -= $mobs[0].BluntSTR - ($NPCs.ShadowScythe.BluntDEF + $NPCs.ShadowScythe.armorBluntDEF)>>
	<</if>>
	<<if $partyMembers.includes("CrimsonSentinel")>>
		<<set $NPCs.CrimsonSentinel.CurHP -= $mobs[0].BluntSTR - ($NPCs.CrimsonSentinel.BluntDEF + $NPCs.CrimsonSentinel.armorBluntDEF)>>
	<</if>>
	<<if $partyMembers.includes("Zegrath")>>
		<<set $NPCs.Zegrath.CurHP -= $mobs[0].BluntSTR - ($NPCs.Zegrath.BluntDEF + $NPCs.Zegrath.armorBluntDEF)>>
	<</if>>
	<<if $partyMembers.includes("BlackWolf")>>
		<<set $NPCs.BlackWolf.CurHP -= $mobs[0].BluntSTR - ($NPCs.BlackWolf.BluntDEF + $NPCs.BlackWolf.armorBluntDEF)>>
	<</if>>
	<<if $NPCs.RadiantRose.CurHP lte 0>>
    	<<set $NPCs.RadiantRose.Affection to 0>>
    	<<run $partyMembers.delete("RadiantRose")>>
	<</if>>
	<<if $NPCs.ShadowScythe.CurHP lte 0>>
   		<<set $NPCs.ShadowScythe.Affection to 0>>
    	<<run $partyMembers.delete("ShadowScythe")>>
	<</if>>
	<<if $NPCs.CrimsonSentinel.CurHP lte 0>> 
	    <<set $NPCs.CrimsonSentinel.Affection to 0>>
	    <<run $partyMembers.delete("CrimsonSentinel")>>
	<</if>>
	<<if $NPCs.BlackWolf.CurHP lte 0>>
		<<set $NPCs.BlackWolf.Dead to true>> 
		<<run $partyMembers.delete("BlackWolf")>>
	<</if>>
	<<if $NPCs.Zegrath.CurHP lte 0>> 
    	<<set $NPCs.Zegrath.Dead to true>>
    	<<run $partyMembers.delete("Zegrath")>>
	<</if>>
	<<if $raidParty == true>>
		<<set $raidHP -= $mobs[0].BluntSTR>>
	<</if>>
	<<set $CurHP -= $mobs[0].BluntSTR - ($BluntDEF + $armorBluntDEF)>>
<</widget>>

<<widget "EventCurrencies">>\
	<<if $OneYearTHF == true>>\
You gained $AnniversaryCoinDrop Anniversary coins.
	<</if>>
    <<if $christmasEvent == true>>\
You obtained $candyCanesCurDrop candy canes.
	<</if>>
<</widget>>

<<widget "Resting">>
	<<set $curStamina += 5 + $INT>>
	<<set $NPCs.ShadowScythe.CurSTM += 5 + $NPCs.ShadowScythe.INT>>
	<<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
	<<set $NPCs.CrimsonSentinel.CurSTM += 5 + $NPCs.CrimsonSentinel.INT>>
	<<set $NPCs.Zegrath.CurSTM += 5 + $NPCs.Zegrath.INT>>
	<<set $NPCs.Marcellus.CurSTM += 5 + $NPCs.Marcellus.INT>>
<</widget>>


