:: Enemies widget [widget] {"position":"2125,725","size":"100,100"}
<<widget mob>>
  <<set _type to _args[0]>>
  <<set _mob to clone(setup.mobs[_type])>>
  <<if def _mob.lvl_range>>
  <<set _mob.lvl to random(_mob.lvl_range.min,_mob.lvl_range.max)>>
  <</if>>
  <<set _mob.MaxHP to (_mob.MaxHP + (_mob.lvl / _mob.HPModifier)) * $difficultyHPmodifier>>
  <<set _mob.CurHP to _mob.MaxHP>>
  <<set _mob.SlashSTR to (_mob.SlashSTR + (_mob.lvl / _mob.STRModifier)) * $difficultySTRmodifier>>
  <<set _mob.PierceSTR to ( _mob.PierceSTR + (_mob.lvl / _mob.STRModifier)) * $difficultySTRmodifier>>
  <<set _mob.BluntSTR to (_mob.BluntSTR + (_mob.lvl / _mob.STRModifier)) * $difficultySTRmodifier>>
  <<run $mobs.push(_mob)>>
<</widget>>

<<widget "Boar1" container>>\
<<set $monstername to "wild Boar">>
<<set $mobXP to 10>>
<<set $mobCoins to 12>>
<<set $mobLvl to random(0, 7)>>
<<set $STRMobModifier to 2>>
<<set $HPMobModifier to 4>>
<<set $MonsterHP to 20 + $mobLvl / $HPMobModifier>>
<<set $monsterSTR to 5 + $mobLvl / $STRMobModifier>>
<<set $monsterDEX to 2>>
<</widget>>

