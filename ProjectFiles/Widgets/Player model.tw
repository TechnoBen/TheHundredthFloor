        <</if>>
	<</if>>
    <<if $isPantsOn is "Starter skirt" && settings.clothes == true>>
		<img class="pants" src = "Textures/armor/StarterGear/StarterSkirt.png" width="140%" />
    <</if>>
<<elseif $gender == "Female">>
