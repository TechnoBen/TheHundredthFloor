<<dateadd '2h'>>
<<set $curFatigue += 250>>
<<goto "Floor 2 staircase">>
<<else>>
<<dateadd '1h'>>
<<set $location to "snowy1">>
<<set $curFatigue += 150>>
<</if>>
<</link>>
<</if>>
