 <<link '☆☆☆ Ragout soup: $threeStarRSoup'>>
  <<set $threeStarRSoup -= 1>>
  <<set $curHunger += 373>>
  <<set $CurHP += 34>>
  <<set $curStamina += 34>>
  <<set $curFatigue -= 25>>
  <<run $('#ui-dialog-body').empty().wiki(Story.get("Inventory").processText())>>
<</link>>
</li>
<</if>>
<<if $AnniversaryCakeVanilla > 0>>
