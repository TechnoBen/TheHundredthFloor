.UIButtons button {
    margin: auto;
    width: 100%;
      text-align: center;
  background-color: #222222;
  font-family: 'Nunito Sans', sans-serif;
color: white;
    letter-spacing: 1px;
text-decoration: none;
    text-transform:uppercase;
  border: 1px solid #444444;
  padding: 3px 23px;
      font-size:90%;
}
:root {  /* Palette */
	--button-colorONE		: #c3c3c3;
	--button-borderONE		: #444444;
	--border-highlightONE	: #c3c3c3;
}
.UIButtons button:hover {
	background-color: var(--button-borderONE);
	border-top: 1.7px solid var(--border-highlightONE);
	border-bottom: 1.7px solid var(--border-highlightONE);
  	border-right: 1.7px solid var(--border-highlightONE);
  	border-left: 1.7px solid var(--border-highlightONE);
}


