                        <</if>>
                    <</if>>
                <</if>>
            <</for>>
            <<HitRelatedStatusPlayer>>
        <<elseif $curStamina <= 25>>
            <<set $attack to "Nothing">>
            <<set $attackText to "Do nothing">>
            <<set $curStamina += 5 + $INT>>
            <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
        <</if>>
    <</if>>
<</if>>
/* Multistrike */
<<if $attack === "Multi strike">>
    <<if $weaponType === "Rapier">>
        <<if $curStamina >= 20>>  
            <<set $curStamina -= 20>>
            <<set $curHunger -= 4>>
            <<set $curFatigue += 10>>
            <<set _attacksMultistrike to Math.round(3 + ($DEX/10))>>
            <<for _i range _attacksMultistrike>>
            <<for _i = 0; _i lte 99; _i++>>
                <<if $enemyHitPlayer === _i>>
                <<set _critChanceRNG to kitsuneRNG(0, 100)>>
                    <<if $critChance <= _critChanceRNG>>
                        <<set $baseDMG to ($weaponPierceDMG + $DEX/2 - ($DEXPercentDebuff*($DEX/2)/100) + ($DEXPercentBuff*($DEX/2)/100) + $PierceSTR - ($STRPercentDebuff*($PierceSTR + $weaponDMG)/100) + ($STRPercentBuff*( $PierceSTR + $weaponDMG)/100)) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedCountCur += $bleedCountDealt>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt * $mobs[_i].bleedDef>>
                        <<run $combat_log.push($gamename + ' leaps into the air, hitting ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                        <<set $CDMultistrike to 6>>
                    <<else>>
                        <<set $baseDMG to (($weaponPierceDMG + $DEX/2 - ($DEXPercentDebuff*($DEX/2)/100) + ($DEXPercentBuff*($DEX/2)/100) + $PierceSTR - ($STRPercentDebuff*($PierceSTR + $weaponDMG)/100) + ($STRPercentBuff*( $PierceSTR + $weaponDMG)/100)) * $critDMG) * $mobs[_i].PierceDEF>>
                        <<set $mobs[_i].CurHP -= $baseDMG>>
                        <<set $dmgDealt.Combat to $baseDMG>>
                        <<set $dmgDealt.Total += $baseDMG>>
						<<set $mobs[_i].bleedPotency += $bleedPotencyDealt*1.5 * $mobs[_i].bleedDef>>
                        <<run $combat_log.push('CRITICAL HIT! ' + $gamename + ' leaps into the air, hitting  ' + $mobs[_i].name + ' dealing ' + $baseDMG.toFixed(2) + ' damage')>>
                        <<set $CDMultistrike to 6>>
                    <</if>>
                <</if>>
            <</for>>
            <<HitRelatedStatusPlayer>>
            <</for>>
        <<elseif $curStamina <= 19>>
            <<set $attack to "Nothing">>
            <<set $attackText to "Do nothing">>
            <<set $curStamina += 5 + $INT>>
            <<run $combat_log.push($gamename + ' is too tired to fight so they do nothing.')>>
        <</if>>
    <</if>>
<</if>>

/* Party combat */
/* RadiantRose */
<<if $partyMembers.includes("RadiantRose")>>
    <<if $attackRadiantRose is "Do nothing">>
    <<run $combat_log.push('RadiantRose does nothing.')>>
        <<if $NPCs.RadiantRose.CurSTM <= $NPCs.RadiantRose.MaxSTM>>
            <<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
        <<elseif $NPCs.RadiantRose.CurSTM >= $NPCs.RadiantRose.MaxSTM>>
            <<set $NPCs.RadiantRose.CurSTM -= 5 + $NPCs.RadiantRose.INT>>
        <</if>>
    <</if>>
    <<set _critChanceRNGRadiant to kitsuneRNG(0, 100)>>
    <<if $attackRadiantRose is "Stab">>
        <<if $NPCs.RadiantRose.CurSTM >= 6>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitRadiantRose === _i>>
            <<if $NPCs.RadiantRose.CritChance <= _critChanceRNGRadiant>>
                <<set $NPCs.RadiantRose.baseDMG to (($NPCs.RadiantRose.PierceSTR + $NPCs.RadiantRose.weaponPierceDMG) * $NPCs.RadiantRose.STRPercentBuff) * $mobs[_i].PierceDEF>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt/1.5>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt/2 * $mobs[_i].bleedDef>>
                <<run $combat_log.push('RadiantRose stabs ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + ' damage')>>
                <<RadiantHiting>>
                <<set $NPCs.RadiantRose.CurSTM -= 6>>
            <<else>>
                <<set $NPCs.RadiantRose.baseDMG to ((($NPCs.RadiantRose.PierceSTR + $NPCs.RadiantRose.weaponPierceDMG) * $NPCs.RadiantRose.CritDMG) * $NPCs.RadiantRose.STRPercentBuff) * $mobs[_i].PierceDEF>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>>
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<run $combat_log.push('CRITICAL HIT! RadiantRose stabs ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + ' damage')>>
                <<RadiantCritting>>
                <<set $NPCs.RadiantRose.CurSTM -= 6>>
            <</if>>
        <</if>>
        <</for>>
        <<HitRelatedStatusRadiant>>
        <<elseif $NPCs.RadiantRose.CurSTM<= 5>>
            <<set $NPCs.RadiantRose.CurSTM += 5 + $NPCs.RadiantRose.INT>>
            <<run $combat_log.push('RadiantRose is too tired to fight so she does nothing.')>>
        <</if>>
    <</if>>
    <<if $attackRadiantRose is "Charge">>
        <<if $NPCs.RadiantRose.CurSTM >= 10>>
        <<for _i = 0; _i lte 99; _i++>>
        <<if $enemyHitRadiantRose === _i>>
            <<if $NPCs.RadiantRose.CritChance <= _critChanceRNGRadiant>>
                <<set $NPCs.RadiantRose.baseDMG to (($NPCs.RadiantRose.weaponPierceDMG + $NPCs.RadiantRose.DEX/2 + $NPCs.RadiantRose.PierceSTR) * $NPCs.RadiantRose.STRPercentBuff) * $mobs[_i].PierceDEF>>
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
                <<set $mobs[_i].CurHP -= $NPCs.RadiantRose.baseDMG>> 
				<<set $mobs[_i].bleedCountCur += $NPCs.RadiantRose.bleedCountDealt>>
				<<set $mobs[_i].bleedPotency += $NPCs.RadiantRose.bleedPotencyDealt * $mobs[_i].bleedDef>>
                <<run $combat_log.push('RadiantRose charges at ' + $mobs[_i].name + ' dealing ' + $NPCs.RadiantRose.baseDMG.toFixed(2) + ' damage')>>
                <<RadiantHiting>>
                <<set $NPCs.RadiantRose.CurSTM -= 10>>
            <<else>>
                <<set $NPCs.RadiantRose.baseDMG to ((($NPCs.RadiantRose.weaponPierceDMG + $NPCs.RadiantRose.DEX/2 + $NPCs.RadiantRose.PierceSTR) * $NPCs.RadiantRose.CritDMG) * $NPCs.RadiantRose.STRPercentBuff) * $mobs[_i].PierceDEF>> 
                <<set $NPCs.RadiantRose.dmgDealtTotal += $NPCs.RadiantRose.baseDMG>>
