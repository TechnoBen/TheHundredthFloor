    <<set $inventory[_tag] = $player.cape>>
    <<goto "Wardrobe">>
  <<set $player.cape = "None">> 
  <<goto "Wardrobe">>
  <</link>> <</if>> + <<if $player.necklace is "None">> Necklace <<else>> <<link "$player.necklace.name">> 
    /* Same code as personality select. I have no idea why or how it works but it does! */
