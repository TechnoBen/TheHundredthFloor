:: Boss rush armor shop [no-fainting-or-hunger] {"position":"1050,875","size":"100,100"}
<<button "Buy leather chesplate | 120 coins">>
<<if $Coins >= 120>> 
<<set $leatherCP to true>>
<<set $Coins -= 120>>
<<goto "Boss rush armor shop">>
<<elseif $Coins <= 119>>
<<script>>
UI.alert("You dont have enough coins!");
