<</widget>>

<<widget HitRelatedStatusZegrath>>

	/* In short, whenever a skill is meant to trigger during a hit (or crit) it activates. */

	<<if $NPCs.Zegrath.PowerUpPotency >= 0.01>>
		<<set $NPCs.Zegrath.STRPercentBuff -= $NPCs.Zegrath.PowerUpPotency>>
		<<set $NPCs.Zegrath.PowerUpPotency /= 2>>
		<<set $NPCs.Zegrath.STRPercentBuff += $NPCs.Zegrath.PowerUpPotency>>
	<</if>>

<</widget>>