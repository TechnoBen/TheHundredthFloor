:: Boss rush weapon shop [no-fainting-or-hunger] {"position":"950,875","size":"100,100"}
<<button "Buy a copper sword | 132 coins">>
<<if $Coins >= 132>> 
<<set $sword1 to true>>
<<set $Coins -= 132>>
<<goto "Boss rush weapon shop">>
<<elseif $Coins <= 131>>
<<script>>
UI.alert("You dont have enough coins!");
<</script>>
<</if>>
<</button>>
