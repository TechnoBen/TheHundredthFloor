<</if>> */

/* Zegrath */

<<if $partyMembers.includes("Zegrath")>>
/* Doing nothing */
<<if $attackZegrath === "Do nothing">>
<<run $combat_log.push('Zegrath does nothing.')>>
<</if>>
/* Blocking */
<<if $attackZegrath === "Block">>
    <<if $NPCs.Zegrath.CurSTM >= 8>>
        <<run $combat_log.push('Zegrath gets into a blocking stance.')>>
        <<set $NPCs.Zegrath.CurSTM -= 8>>
        <<set $NPCs.Zegrath.blockingModifier to 0.5>>
    <<else>>
        <<run $combat_log.push('Zegrath doesnt feel like blocking.')>>
    <</if>>
<</if>>
/* Dodging */
<<if $attackZegrath === "Dodge">>
    <<if $NPCs.Zegrath.CurSTM >= 15>>
        <<run $combat_log.push('Zegrath gets ready to dodge.')>>
        <<set $NPCs.Zegrath.CurSTM -= 15>>
        <<set $NPCs.Zegrath.evadeModifier to 75>>
    <<else>>
        <<run $combat_log.push('Zegrath does not feel like dodging.')>>
    <</if>>
<</if>>
<</if>>

/* Mobs attacking */
<<set _npc = $NPCs[_i]>>
<<set _mob = $mobs>>
<<for _i = 0; _i lt $mobs.length; _i++>>
    /* BOARS */
    <<if _mob[_i].name is "Wild Boar" && _mob[_i].turnChanceCur > 0 or _mob[_i].name is "Ram" && _mob[_i].turnChanceCur > 0>>
        <<set _randomHit to random(0, $partyMembers.length)>>
        <<set _critChanceRNG to kitsuneRNG(0, 100)>>
        <<set _mobHit to kitsuneRNG(0, 100)>>
        <<if _randomHit <= $partyMembers.length - 1>>
            <<set _npc = $NPCs[$partyMembers[_randomHit]]>>
            <<if _npc.evadeModifier <= _mobHit>>
                <<if _mob[_i].CritChance <= _critChanceRNG>>
                    <<set _mob[_i].baseDMG to ((_mob[_i].BluntSTR - ((_npc.BluntDEF + _npc.armorBluntDEF) * _npc.DEFPercentBuff)) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                    <<set _npc.CurHP -= _mob[_i].baseDMG>>
					<<set _npc.burnPotency += _mob[_i].burnPotencyDealt>>
					<<set _npc.burnCountCur += _mob[_i].burnCountDealt>>
                    <<set _npc.DazedPotency += 2>>
                    <<set _npc.DazedCount += 1>>
                    <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' charges towards ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                    <<GettingHit>>
                <<else>>
                    <<set _mob[_i].baseDMG to (((_mob[_i].BluntSTR - ((_npc.BluntDEF + _npc.armorBluntDEF) * _npc.DEFPercentBuff)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * _npc.blockingModifier>>
                    <<set _npc.CurHP -= _mob[_i].baseDMG>>
					<<set _npc.burnPotency += _mob[_i].burnPotencyDealt*2>>
					<<set _npc.burnCountCur += _mob[_i].burnCountDealt*2>>
                    <<set _npc.DazedPotency += 5>>
                    <<set _npc.DazedCount += 1>>
                    <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' charges towards ' + _npc.name + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                    <<GettingCritted>>
                    <<CritRelatedStatusesMobs>>
                <</if>>
            <<else>>
              <<run $combat_log.push(_npc.name + ' dodges the attack from ' + _mob[_i].name)>>
            <</if>>
            <<set _npc.blockingModifier to 1>>
            <<set _npc.evadeModifier to 0>>
            <<HitRelatedStatusMobs>>
        <<else>>
            <<if $evadeModifier <= _mobHit>>
                <<if _mob[_i].CritChance <= _critChanceRNG>>
                    <<set _mob[_i].baseDMG to ((_mob[_i].BluntSTR - (($BluntDEF + $armorBluntDEF) * $DEFPercentBuff)) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                    <<set $CurHP -= _mob[_i].baseDMG>>
					<<set $burnPotency += _mob[_i].burnPotencyDealt>>
					<<set $burnCountCur += _mob[_i].burnCountDealt>>
                    <<set $DazedPotency += 2>>
                    <<set $DazedCount += 1>>
                    <<run $combat_log.push('Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' charges towards ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                    <<GettingHitPlayer>>
                <<else>>
                    <<set _mob[_i].baseDMG to (((_mob[_i].BluntSTR - (($BluntDEF + $armorBluntDEF) * $DEFPercentBuff)) * _mob[_i].CritDMG) * _mob[_i].STRPercentBuff) * $blockingModifier>>
                    <<set $CurHP -= _mob[_i].baseDMG>>
					<<set $burnPotency += _mob[_i].burnPotencyDealt>>
					<<set $burnCountCur += _mob[_i].burnCountDealt>>
                    <<set $DazedPotency += 5>>
                    <<set $DazedCount += 1>>
                    <<run $combat_log.push('CRITICAL HIT! Level: ' + _mob[_i].lvl + ' ' + _mob[_i].name + ' charges towards ' + $gamename + ' and dealt ' + _mob[_i].baseDMG.toFixed(2) + '<img class="status" src = "Textures/Statuses/Blunt.png" />damage')>>
                    <<GettingCrittedPlayer>>
                    <<CritRelatedStatusesMobs>>
                <</if>>
            <<else>>
              <<run $combat_log.push($gamename + ' dodges the attack from ' + _mob[_i].name)>>
            <</if>>
            <<set $blockingModifier to 1>>
            <<set $evadeModifier to 0>>
            <<HitRelatedStatusMobs>>
        <</if>>
    <</if>>
    /* RABBITS, WOLVES, MIMICS */
    <<if _mob[_i].name is "Rabbit" && _mob[_i].turnChanceCur > 0 or _mob[_i].name is "White wolf" && _mob[_i].turnChanceCur > 0 or _mob[_i].name is "Glowing chest" && _mob[_i].turnChanceCur > 0>>
	<<if _mob[_i].turnChanceCur >= 0.01>>
        <<set _mobSkill to random(0, 100)>>
        <<set _randomHit to random(0, $partyMembers.length)>>
        <<set _critChanceRNG to kitsuneRNG(0, 100)>>
        <<set _mobHit to kitsuneRNG(0, 100)>>
        /* Slashing */
