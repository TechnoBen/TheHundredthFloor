        <<run console.log($NPCs[_members])>>
        <<for _members range $partyMembers>>
        <<if $enemyHitPlayer === _members>>
            <<if $hpPOT >= 1>>
                <<set _npc.CurHP += 50>>
                <<set $hpPOT -= 1>>
                <<run $combat_log.push('You give a tier 1 health potion to ' + _npc.name)>>
            <<elseif $hpPOT <= 0>>
                <<run $combat_log.push('You dont have any tier 1 health potions to give to your teammates.')>>
            <</if>>
        <</if>>
        <</for>>
    <</if>>
<</if>> */
/* HP pot tier 2 */
<<if $attack is "Drink a HP potion tier 2">>
    <<if $enemyHitPlayer === "Player" && $hpPOT1 >= 1 && $potCooldown <= 0>>
        <<set $RegenHP += 2>>
        <<set $RegenAmount to 60>>
        <<set $hpPOT1 -= 1>>
        <<set $potCooldown += 4>>
        <<run $combat_log.push('You drink a tier 2 potion.')>>
    <<elseif $enemyHitPlayer === "RadiantRose" && $hpPOT1 >= 1>>
        <<set $NPCs.RadiantRose.CurHP += 120>>
        <<set $hpPOT1 -= 1>>
        <<run $combat_log.push('You gave a tier 2 health potion to RadiantRose')>>
    <<elseif $enemyHitPlayer === "CrimsonSentinel" && $hpPOT1 >= 1>>
        <<set $NPCs.CrimsonSentinel.CurHP += 120>>
        <<set $hpPOT1 -= 1>>
        <<run $combat_log.push('You gave a tier 2 health potion to CrimsonSentinel')>>
    <<elseif $enemyHitPlayer === "ShadowScythe" && $hpPOT1 >= 1>>
        <<set $NPCs.ShadowScythe.CurHP += 120>>
        <<set $hpPOT1 -= 1>>
        <<run $combat_log.push('You gave a tier 2 health potion to ShdaowScythe')>>
    <<elseif $enemyHitPlayer === "Zegrath" && $hpPOT1 >= 1>>
        <<set $NPCs.Zegrath.CurHP += 120>>
        <<set $hpPOT1 -= 1>>
        <<run $combat_log.push('You gave a tier 2 health potion to Zegrath')>>
    <<elseif $hpPOT1 <= 1>>
        <<run $combat_log.push('You dont have any tier 2 health potions')>>
    <</if>>
<</if>>
