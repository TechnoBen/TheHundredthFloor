:: StoryScript [script]
Save.onSave.add(function (save) {
    save.desc = State.variables.gamename + ":" + " Level: " + State.variables.Level.toFixed(0) + " HP: " + State.variables.CurHP.toFixed(0) + "/" + State.variables.MaxHP.toFixed(0) + " XP: " + State.variables.CurXP.toFixed(0) + "/" + State.variables.MaxXP.toFixed(0);
});

Config.saves.autosave = function () {
	if (tags().contains("autosave")) {
		return true;
	}
	return false;
};

Config.saves.onLoad = function(save) {
	// Initialize undefined new variables in each moment of  the saved history.
	for(let i=0; i<save.state.history.length; ++i) {
		let variables = save.state.history[i].variables
		// Do something like these three lines for each new variable:
        
        // Event related variable setters
        
        if(typeof variables.OneYearTHF === 'undefined') {
			variables.OneYearTHF = false;
		}
      	if(typeof variables.OneYearTHF === 'true') {
			variables.OneYearTHF = false;
		} 
      	if(typeof variables.AnniversaryCoins === 'undefined') {
			variables.AnniversaryCoins = 0;
		}
      	if(typeof variables.genderChangingPotion === 'undefined') {
			variables.genderChangingPotion = 0;
