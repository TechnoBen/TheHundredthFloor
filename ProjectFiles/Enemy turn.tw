Select your move:<<nobr>>
<label>
    <<radiobutton "$attack" "Do nothing" checked>> Do nothing
</label>
<<if $StunnedCount <= 0>><label>
<label>
     | <<radiobutton "$attack" "Block">> Block
</label>
<label>
     | <<radiobutton "$attack" "Dodge">> Dodge
</label>
<<if $weaponType is "Shield and sword">>
<label>
    <<if $CDBrace >= 1>> | CD: $CDBrace Brace for impact<<else>> | <<radiobutton "$attack" "Brace for impact">> Brace for impact<</if>>
</label>
<</if>>
<<if $hpPOT >= 1>> 
    <label>
         | <<radiobutton "$attack" "Drink a HP potion">> Drink a tier 1 health potion</label>
<</if>>
<<if $hpPOT1 >= 1>>
    <label>
        | <<radiobutton "$attack" "Drink a HP potion tier 2">> Drink a tier 2 health potion
    </label>
<</if>>
<<if $stmPOT >= 1>>
    <label>
         | <<radiobutton "$attack" "Drink a STM potion">> Drink a tier 1 stamina potion
    </label>
<</if>>
<<for _i = 0; _i lt $mobs.length; _i++>>
    <<if _mob[_i].name is "Black wolf" && $ragoutMeat >= 1>>
        <label>
             | <<radiobutton "$attack" "Feed dog">> Give the Black wolf ragout meat
        </label>
    <</if>>
<</for>>
<</if>>
<</nobr>>
<<nobr>>
Select a party member: 
