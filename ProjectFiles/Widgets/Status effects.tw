	/* In short, whenever a skill is meant to trigger during a hit (or crit) it activates. */

	<<if $NPCs.RadiantRose.PowerUpPotency >= 0.01>>
		<<set $NPCs.RadiantRose.STRPercentBuff -= $NPCs.RadiantRose.PowerUpPotency>>
		<<set $NPCs.RadiantRose.PowerUpPotency /= 2>>
		<<set $NPCs.RadiantRose.STRPercentBuff += $NPCs.RadiantRose.PowerUpPotency>>
