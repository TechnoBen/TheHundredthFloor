	<<if _randomencounter lte 15>>
    	<<set $lastVisitedPassage to "Plains">>
		<<goto "Encounter F1">>
    <</if>>
<</link>>

You can:
1. <<link [[Look for a boar|Combat remake]]>>
<<set $lastVisitedPassage to "Path 1">>
<<set _mobAmount to random(100)>>
        <<if _mobAmount lte 5 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
        	<<mob boar1>>
            <<mob boar1>>
            <<mob boar1>>
            <<mob boar1>>
            <<goto "Combat remake">>
        <<elseif _mobAmount lte 15 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
            <<mob boar1>>
            <<mob boar1>>
            <<mob boar1>>
            <<goto "Combat remake">>
        <<elseif _mobAmount lte 30 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
            <<mob boar1>>
            <<mob boar1>>
            <<goto "Combat remake">>
        <<elseif _mobAmount lte 100 && $beingFollowedPK <= 0 && $beingFollowedSC <= 0>>
            <<mob boar1>>
            <<goto "Combat remake">>
        <</if>>
<<dateadd '10m'>>
<<set $curFatigue += 10>>
<</link>>


