<<widget CritRelatedStatusesMobs>>

/* Triggers whenever a crit happens */

	<<if _mob[_i].PoisePotency >= 0.01>>
		<<set $mobs[_i].CritChance -= $mobs[_i].PoisePotency>>
		<<set $mobs[_i].PoisePotency to 0>>
		<<set $mobs[_i].CritChance += $mobs[_i].PoisePotency>>
		<<set $mobs[_i].CritDMG -= $mobs[_i].PoiseCount/10>>
		<<set $mobs[_i].PoiseCount -= 1>>
		<<set $mobs[_i].CritDMG += $mobs[_i].PoiseCount/10>>
	<</if>>


<</widget>>

<<widget CritRelatedStatusesPlayer>>

/* Triggers whenever a crit happens */
	<<if $PoisePotency >= 0.01>>
		<<set $critChance -= $PoisePotency>>
		<<set $PoisePotency to 0>>
		<<set $critChance += $PoisePotency>>
		<<set $critDMG -= $PoiseCount/10>>
		<<set $PoiseCount -= 1>>
		<<set $critDMG += $PoiseCount/10>>
