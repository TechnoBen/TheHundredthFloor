    <<set _barkChanceCrimCrit to random(0, 100)>>
    <<set _barkChoiceCrimCrit to random(1, 2)>>
    
    <<if _barkChanceCrimCrit >= 25>>
        <<if _barkChoiceCrimCrit === 1>>
