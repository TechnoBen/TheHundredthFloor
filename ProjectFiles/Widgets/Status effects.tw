<</widget>>

<<widget "dazedMobs">>
	<<for _i = 0; _i lt $mobs.length; _i++>>
	<<if _mob[_i].DazedCount >= 0.01>>
    	<<set _rngDazedMobs to random(0, _mob[_i].turnChanceMax)>>
		<<if _rngDazedMobs <= _mob[_i].DazedPotency>>
			<<set $mobs[_i].StunnedCount += 4>>
			<<set $mobs[_i].DazedPotency /= 2>>
			<<set $mobs[_i].DazedCount -= 1>>
			<<run $combat_log.push('<span class="stun"><img class="status" src = "Textures/Statuses/Stunned.png" />Level ' + $mobs[_i].lvl + ' ' + $mobs[_i].name + ' got stunned<img class="status" src = "Textures/Statuses/Stunned.png" /></span>')>>
		<<else>>
			<<set $mobs[_i].DazedCount -= 1>>
		<</if>>
	<<else>>
		<<set $mobs[_i].DazedPotency to 0>>
	<</if>>
	<</for>>
<</widget>>

<<widget "dazedPlayers">>
	/* Player turn passage */

	/* Player dazed */
	<<if $DazedCount >= 0.01>>
    <<set _rngDazed to random(0, $turnChanceMax)>>
		<<if _rngDazed <= $DazedPotency>>
			<<set $StunnedCount += 4>>
			<<set $DazedPotency /= 2>>
			<<set $DazedCount -= 1>>
			<<run $combat_log.push('<span class="stun"><img class="status" src = "Textures/Statuses/Stunned.png" />' + $gamename + ' got stunned<img class="status" src = "Textures/Statuses/Stunned.png" /></span>')>>
		<<else>>
			<<set $DazedCount -= 1>>
		<</if>>
	<<else>>
		<<set $DazedPotency to 0>>
	<</if>>

	/* Radiant dazed */
	<<if $NPCs.RadiantRose.DazedCount >= 0.01>>
    <<set _rngDazed1 to random(0, $NPCs.RadiantRose.turnChanceMax)>>
		<<if _rngDazed1 <= $NPCs.RadiantRose.DazedPotency>>
			<<set $NPCs.RadiantRose.StunnedCount += 4>>
			<<set $NPCs.RadiantRose.DazedPotency /= 2>>
			<<set $NPCs.RadiantRose.DazedCount -= 1>>
			<<run $combat_log.push('<span class="stun"><img class="status" src = "Textures/Statuses/Stunned.png" />RadiantRose got stunned<img class="status" src = "Textures/Statuses/Stunned.png" /></span>')>>
		<<else>>
			<<set $NPCs.RadiantRose.DazedCount -= 1>>
		<</if>>
	<<else>>
		<<set $NPCs.RadiantRose.DazedPotency to 0>>
	<</if>>

	/* Shadow dazed */
	<<if $NPCs.ShadowScythe.DazedCount >= 0.01>>
    <<set _rngDazed2 to random(0, $NPCs.ShadowScythe.turnChanceMax)>>
		<<if _rngDazed2 <= $NPCs.ShadowScythe.DazedPotency>>
			<<set $NPCs.ShadowScythe.StunnedCount += 4>>
			<<set $NPCs.ShadowScythe.DazedPotency /= 2>>
			<<set $NPCs.ShadowScythe.DazedCount -= 1>>
			<<run $combat_log.push('<span class="stun"><img class="status" src = "Textures/Statuses/Stunned.png" />ShadowScythe got stunned<img class="status" src = "Textures/Statuses/Stunned.png" /></span>')>>
		<<else>>
			<<set $NPCs.ShadowScythe.DazedCount -= 1>>
		<</if>>
	<<else>>
		<<set $NPCs.ShadowScythe.DazedPotency to 0>>
	<</if>>

	/* Crim dazed */
	<<if $NPCs.CrimsonSentinel.DazedCount >= 0.01>>
    <<set _rngDazed3 to random(0, $NPCs.CrimsonSentinel.turnChanceMax)>>
		<<if _rngDazed3 <= $NPCs.CrimsonSentinel.DazedPotency>>
			<<set $NPCs.CrimsonSentinel.StunnedCount += 4>>
			<<set $NPCs.CrimsonSentinel.DazedPotency /= 2>>
			<<set $NPCs.CrimsonSentinel.DazedCount -= 1>>
			<<run $combat_log.push('<span class="stun"><img class="status" src = "Textures/Statuses/Stunned.png" />CrimsonSentinel got stunned<img class="status" src = "Textures/Statuses/Stunned.png" /></span>')>>
		<<else>>
			<<set $NPCs.CrimsonSentinel.DazedCount -= 1>>
		<</if>>
	<<else>>
		<<set $NPCs.CrimsonSentinel.DazedPotency to 0>>
	<</if>>

	/* Zegrath dazed */
	<<if $NPCs.Zegrath.DazedCount >= 0.01>>
    <<set _rngDazed4 to random(0, $NPCs.Zegrath.turnChanceMax)>>
		<<if _rngDazed4 <= $NPCs.Zegrath.DazedPotency>>
			<<set $NPCs.Zegrath.StunnedCount += 4>>
			<<set $NPCs.Zegrath.DazedPotency /= 2>>
			<<set $NPCs.Zegrath.DazedCount -= 1>>
			<<run $combat_log.push('<span class="stun"><img class="status" src = "Textures/Statuses/Stunned.png" />Zegrath got stunned<img class="status" src = "Textures/Statuses/Stunned.png" /></span>')>>
		<<else>>
			<<set $NPCs.Zegrath.DazedCount -= 1>>
		<</if>>
	<<else>>
		<<set $NPCs.Zegrath.DazedPotency to 0>>
	<</if>>

<</widget>>

<<widget "dazedPotencyMobs">>
	<<for _i = 0; _i lt $mobs.length; _i++>>
	<<if _mob[_i].DazedCount <= 0.01>>
		<<set $mobs[_i].DazedPotency to 0>>
	<</if>>
	<</for>>
<</widget>>

<<widget "dazedPotencyPlayers">>
	/* Player turn passage */

	/* Player dazed */
	<<if $DazedCount <= 0>>
		<<set $DazedPotency to 0>>
	<</if>>

	/* Radiant dazed */
	<<if $NPCs.RadiantRose.DazedCount <= 0>>
		<<set $NPCs.RadiantRose.DazedPotency to 0>>
	<</if>>

	/* Shadow dazed */
	<<if $NPCs.ShadowScythe.DazedCount <= 0>>
		<<set $NPCs.ShadowScythe.DazedPotency to 0>>
	<</if>>

	/* Crim dazed */
	<<if $NPCs.CrimsonSentinel.DazedCount <= 0>>
		<<set $NPCs.CrimsonSentinel.DazedPotency to 0>>
	<</if>>

	/* Zegrath dazed */
	<<if $NPCs.Zegrath.DazedCount <= 0>>
		<<set $NPCs.Zegrath.DazedPotency to 0>>
	<</if>>

<</widget>>

<<widget "stunnedMobs">>
	<<for _i = 0; _i lt $mobs.length; _i++>>
	<<if _mob[_i].StunnedCount >= 0.01>>
		<<set $mobs[_i].turnChanceCur -= $mobs[_i].turnChanceMax>>
		<<set $mobs[_i].StunnedCount -= 1>>
	<</if>>
	<</for>>
<</widget>>

<<widget "stunnedPlayers">>
/* Player turn passage */

	/* Player stun */
	<<if $StunnedCount >= 0.01>>
