      <<set _tag = $player.shirt.id + (_count + 1)>>
    <</for>>
    <<set $inventory[_tag] = $player.shirt>>
    <<goto "Wardrobe">>
  <<set $player.shirt = "None">> 
  <<goto "Wardrobe">>
  <</link>> <</if>> + <<if $player.chestplate is "None">> Chestplate <<else>> <<link "$player.chestplate.name">> 
