                    <<notify>> You bought a blue shirt! <</notify>>
                    <<goto "Buy clothes">>
                <<elseif $Coins <= 24>>
                    <<script>>
                        UI.alert("You dont have enough col!");
                    <</script>>
                <</if>>
            <</link>>
        </div>\
    </div>\
</div>\
