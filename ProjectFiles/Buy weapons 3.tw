:: Buy weapons 3 [no-fainting-or-hunger no-party-time-loss] {"position":"3775,1850","size":"100,100"}
<center>
<div class="cols">\
    <div class="col1">\
        <div class="border1">\
	        <div class="paperdoll">\
    		    <img src = "Textures/Body/Mannequin.png" style="transform: translate(-20px);" />\
                <img class="sword" src = "Textures/weapons/Iron sword.png" style="transform: translate(-119px)" />\
    	    </div>\
        </div>\
        <div class="border2">\
            Iron sword:
            Slash DMG + 6
            Pierce DMG + 2.25
        </div>\
        <div class="border1">\
            <<link "Buy the sword | 723 col">>
                <<if $Coins >= 723>> 
                    <<set $sword4 to true>>
                    <<notify>> You bought an iron sword! <</notify>>
                    <<set $Coins -= 723>>
                    <<goto "Buy weapons 3">>
                <<elseif $Coins <= 723>>
