:: Buy items [no-fainting-or-hunger no-party-time-loss] {"position":"1725,1625","size":"100,100"}
<<nobr>><h2>Potions:</h2><</nobr>>\
<<button "Buy health potion | 48 col">>
<<if $Coins >= 48>> 
<<set $hpPOT += 1>>
<<notify>> You bought a tier 1 health potion! <</notify>>
<<goto "Buy items">>
<<set $Coins -= 48>>
<<elseif $Coins <= 47>>
<<script>>
UI.alert("You dont have enough coins!");
<</script>>
<</if>>
<</button>>
<<button "Buy stamina potion | 56 col">>
<<if $Coins >= 56>> 
<<set $stmPOT += 1>>
<<notify>> You bought a tier 1 stamina potion!<</notify>>
<<goto "Buy items">>
<<set $Coins -= 56>>
<<elseif $Coins <= 55>>
<<script>>
UI.alert("You dont have enough coins!");
<</script>>
<</if>>
<</button>>
